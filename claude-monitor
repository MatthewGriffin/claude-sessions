 term:['#######','#.#...#','#..#..#','#.#.###','#######'],
 doc:['.#####.','.#...#.','.#####.','.#...#.','.#####.'],
 edit:['.....##','....##.','...##..','#.##...','##.....'],
 find:['.###...','#...#..','#...#..','.###.#.','.....##'],
 web:['..###..','.#.#.#.','#######','.#.#.#.','..###..'],
 team:['.#...#.','###.###','.#...#.','#.#.#.#','.......'],

def format_age(seconds):
    seconds = max(0, int(seconds))
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m"
    if seconds < 86400:
        return f"{seconds // 3600}h{seconds % 3600 // 60:02d}m"
    return f"{seconds // 86400}d{seconds % 86400 // 3600}h"


def format_tokens(count):
    if not count:
        return "-"
    return f"{count / 1000:.0f}k" if count < 999500 else f"{count / 1e6:.1f}M"


def describe_tool(name, tool_input):
    if isinstance(tool_input, dict):
        for key in ("description", "file_path", "command", "pattern", "query", "skill", "url", "prompt"):
            if tool_input.get(key):
                return f"{name}: {clean(tool_input[key])}"
    return name


class Transcript:
    """Follows one session's transcript, parsing only bytes added since last poll."""

    def __init__(self, session_id, path=None, is_subagent=False):
        self.session_id = session_id
        self.path = path
        self.is_subagent = is_subagent
        self.subagents = {}
        self.offset = None
        self.mtime = None
        self.title = self.prompt = self.text = self.model = self.branch = ""
        self.context = 0
        self.actions = collections.deque(maxlen=8)
        self.pending = {}
        self.permission_mode = ""
        self.failure = None  # The API error that ended the last turn, until something follows it.
        self.human_messages = 0
        self.device_uses = {}  # Emulator serial -> when a shell command last named it.
        self.background = {}  # Background task id -> what it is and when it started, until it reports back.
        self.background_ended = set()
        self.not_background = set()  # Open task files that turned out to be ordinary, foreground commands.
        self.read_whole = False

    def poll(self):
        if self.path is None:
            matches = glob.glob(os.path.join(CONFIG_DIR, "projects", "*", glob.escape(self.session_id) + ".jsonl"))
            if not matches:
                return
            self.path = matches[0]
        try:
            stat = os.stat(self.path)
            self.mtime = stat.st_mtime
            if self.offset is not None and stat.st_size == self.offset:
                return
            if self.offset is None or stat.st_size < self.offset:
                # Large pasted content can push the last tool call far from the end,
                # so widen the window until it's found. Later lines overwrite earlier ones.
                window = FIRST_READ_BYTES
                while True:
                    start = max(0, stat.st_size - window)
                    self._read(start, start > 0)
                    self.read_whole = start == 0
                    if start == 0 or (self.actions and self.title):
                        break
                    window *= 4
            else:
                self._read(self.offset, False)
        except OSError:
            pass

    def _read(self, start, starts_mid_line):
        with open(self.path, "rb") as handle:
            handle.seek(start)
            data = handle.read()
        # A trailing partial line stays unread until the writer finishes it.
        end = data.rfind(b"\n") + 1
        self.offset = start + end
        lines = data[:end].split(b"\n")
        for line in lines[1:] if starts_mid_line else lines:
            if line:
                try:
                    self._ingest(json.loads(line))
                except (ValueError, TypeError, AttributeError):
                    continue

    def _ingest(self, entry):
        kind = entry.get("type")
        if kind == "ai-title":
            self.title = clean(entry.get("aiTitle", ""))
        elif kind == "attachment":
            attachment = entry.get("attachment") or {}
            if attachment.get("type") == "queued_command":
                self._note_task_ends(attachment.get("prompt"))
                self.human_messages += 1
        elif kind == "queue-operation":
            content = entry.get("content")
            self._note_task_ends(content)
            # A message typed while Claude works is recorded here at once, and only reaches the chat later.
            if entry.get("operation") == "enqueue" and isinstance(content, str) and "<task-notification>" not in content:
                self.human_messages += 1
        elif kind == "permission-mode":
            self.permission_mode = str(entry.get("permissionMode", ""))
        elif kind == "last-prompt":
            self.prompt = clean(entry.get("lastPrompt", ""))
        elif kind in ("assistant", "user") and (self.is_subagent or not entry.get("isSidechain")):
            self.branch = entry.get("gitBranch") or self.branch
            # Each message records the mode it was sent in. After /clear, this can be the only record.
            if kind == "user" and entry.get("permissionMode"):
                self.permission_mode = str(entry["permissionMode"])
            message = entry.get("message") or {}
            content = message.get("content")
            blocks = content if isinstance(content, list) else []
            self._note_outcome(entry, kind, content, blocks)
            if kind == "assistant":
                self._ingest_assistant(message, blocks, entry.get("timestamp"))
            else:
                self._note_task_ends(content)
                result = entry.get("toolUseResult") if isinstance(entry.get("toolUseResult"), dict) else {}
                for block in blocks:
                    if isinstance(block, dict) and block.get("type") == "tool_result":
                        call = self.pending.pop(block.get("tool_use_id"), None)
                        task = result.get("backgroundTaskId")
                        if task and isinstance(task, str) and task not in self.background_ended:
                            self.background[task] = {
                                "id": task,
                                "description": (call or "Background command").removeprefix("Bash: ")[:MAX_TEXT],
                                "started": entry_time(entry),
                            }
                    elif isinstance(block, dict) and block.get("type") == "text":
                        self._note_task_ends(block.get("text"))

    def _note_outcome(self, entry, kind, content, blocks):
        if self.is_subagent or entry.get("isMeta"):
            return
        if kind == "assistant" and entry.get("isApiErrorMessage"):
            text = " ".join(b.get("text", "") for b in blocks if isinstance(b, dict))
            limits = entry.get("quotaLimits") if isinstance(entry.get("quotaLimits"), dict) else {}
            resets = limits.get("resetsAt")
            self.failure = {
                "message": clean(text)[:MAX_TEXT] or "The request failed.",
                "kind": clean(entry.get("error", "")),
                "at": entry_time(entry),
                "resets": resets if isinstance(resets, (int, float)) else None,
            }
            return
        self.failure = None  # Anything after it, including Claude Code's own retry, means it moved on.
        origin = entry.get("origin") if isinstance(entry.get("origin"), dict) else {}
        has_text = isinstance(content, str) or any(isinstance(b, dict) and b.get("type") == "text" for b in blocks)
        if kind == "user" and has_text and origin.get("kind", "human") == "human":
            self.human_messages += 1

    def _ingest_assistant(self, message, blocks, timestamp=None):
        model = message.get("model")
        if model and not model.startswith("<"):
            self.model = model.removeprefix("claude-")
        usage = message.get("usage") or {}
        total = sum(usage.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        self.context = total or self.context
        for block in blocks:
            if not isinstance(block, dict):
                continue
            if block.get("type") == "text" and clean(block.get("text", "")):
                self.text = clean(block["text"])
            elif block.get("type") == "tool_use":
                description = describe_tool(block.get("name", "?"), block.get("input"))
                self.actions.append(description)
                self.pending[block.get("id")] = description
                self._note_device_uses(block, timestamp)
                if block.get("name") in ("TaskStop", "KillShell", "KillBash"):
                    tool_input = block.get("input") or {}
                    self._end_task(tool_input.get("task_id") or tool_input.get("shell_id"))

    def _note_task_ends(self, text):
        """A task notification that isn't a progress update means that background task is over."""
        if not isinstance(text, str) or "<task-notification>" not in text:
            return
        for note in TASK_NOTIFICATION.findall(text):
            task = TASK_ID.search(note)
            status = TASK_STATUS.search(note)
            if task and not (status and status.group(1) == "running"):
                self._end_task(task.group(1))

    def _end_task(self, task):
        if not isinstance(task, str) or not task:
            return
        self.background.pop(task, None)
        if len(self.background_ended) > 500:
            self.background_ended.clear()
        self.background_ended.add(task)

    def background_tasks(self, live, started_at=None):
        """Background tasks still running. live is the set of task ids whose output file is open, or None if unknown.

        Foreground commands write to the same kind of file, so the transcript decides what is a
        background task. With live known, a task whose start lies before the part of the transcript
        that was read is looked up by its id. Without it, tasks from before this Claude Code
        process started are dropped, because ending the process ends them.
        """
        if live is not None:
            for task in live - self.background.keys() - self.background_ended - self.not_background:
                found = None if self.read_whole else self._find_task_start(task)
                if found:
                    self.background[task] = found
                else:
                    self.not_background.add(task)
            tasks = [t for i, t in self.background.items() if i in live]
        else:
            tasks = [t for t in self.background.values() if not started_at or not t["started"] or t["started"] >= started_at]
        return sorted(tasks, key=lambda t: t["started"] or 0)

    def _find_task_start(self, task):
        if not self.path or not re.fullmatch(r"[A-Za-z0-9_-]{1,40}", task):
            return None
        marker = f'"backgroundTaskId": "{task}"'.encode()
        marker_compact = f'"backgroundTaskId":"{task}"'.encode()
        try:
            with open(self.path, "rb") as handle:
                for line in handle:
                    if marker not in line and marker_compact not in line:
                        continue
                    entry = json.loads(line)
                    found = {"id": task, "description": "Background command", "started": entry_time(entry)}
                    blocks = (entry.get("message") or {}).get("content")
                    use_id = next((b.get("tool_use_id") for b in blocks if isinstance(b, dict) and b.get("tool_use_id")), None) if isinstance(blocks, list) else None
                    if use_id:
                        found["description"] = self._find_tool_description(use_id) or found["description"]
                    return found
        except (OSError, ValueError, TypeError, AttributeError):
            pass
        return None

    def _find_tool_description(self, use_id):
        marker = use_id.encode()
        with open(self.path, "rb") as handle:
            for line in handle:
                if marker in line and b'"tool_use"' in line:
                    entry = json.loads(line)
                    for block in (entry.get("message") or {}).get("content") or []:
                        if isinstance(block, dict) and block.get("id") == use_id:
                            return describe_tool(block.get("name", "?"), block.get("input")).removeprefix("Bash: ")[:MAX_TEXT]
        return None

    def _note_device_uses(self, block, timestamp):
        command = (block.get("input") or {}).get("command") if block.get("name") == "Bash" else None
        if not command or not timestamp:
            return
        try:
            used_at = datetime.datetime.fromisoformat(timestamp).timestamp()
        except ValueError:
            return
        for serial in EMULATOR_SERIAL.findall(str(command)):
            self.device_uses[serial] = used_at
        for port in BROWSER_PORT_USE.findall(str(command)):
            self.device_uses[f"browser-{port}"] = used_at

    def subagent_states(self):
        """Poll this session's subagent transcripts and report each one's state."""
        if not self.path:
            return []
        directory = self.path[: -len(".jsonl")] + "/subagents"
        found = []
        for path in glob.glob(os.path.join(glob.escape(directory), "agent-*.jsonl")):
            try:
                found.append((os.path.getmtime(path), path))
            except OSError:
                continue
        states = []
        for mtime, path in sorted(found)[-MAX_SUBAGENTS:]:
            agent_id = os.path.basename(path)[len("agent-") : -len(".jsonl")]
            agent = self.subagents.setdefault(path, Transcript(agent_id, path, is_subagent=True))
            agent.poll()
            meta = subagent_meta(path)
            quiet = time.time() - mtime
            # Background agents have no pending parent call, so recent writes also count.
            running = meta.get("toolUseId") in self.pending or quiet < SUBAGENT_ACTIVE_SECONDS
            working = running and not meta.get("finished")
            now = list(agent.pending.values())[-1] if agent.pending else ""
            states.append({
                "id": agent_id,
                "type": clean(meta.get("agentType", "agent")),
                "description": clean(meta.get("description", ""))[:MAX_TEXT],
                "state": "working" if working else "done",
                "now": now[:MAX_TEXT],
                "last": agent.actions[-1][:MAX_TEXT] if agent.actions else "",
                "quiet": int(quiet),
            })
        return states


class Monitor:
    def __init__(self):
        self.sessions = []
        self.transcripts = {}
        self.error = ""
        self.lock = threading.Lock()
        self.cached = None
        self.cached_at = 0
        self.history_lock = threading.Lock()
        self.history_reader = None
        self.git_states = {}  # Folder -> when git was last asked about it, and its answer.
        self.panes = {}
        self.pid_ids = {}
        self.id_changes = []
        self.retired_ids = set()
        self.previous = []
        self.remember = True
        self.devices = []
        self.adb = None
        self.frames = {}
        self.frames_lock = threading.Lock()

    def refresh(self):
        try:
            result = subprocess.run(
                ["claude", "agents", "--json"], capture_output=True, text=True, timeout=15
            )
            if result.returncode != 0:
                raise RuntimeError(clean(result.stderr) or f"exit code {result.returncode}")
            self.sessions = sorted(json.loads(result.stdout), key=lambda s: s.get("startedAt", 0))
            names = read_names()
            for session in self.sessions:
                session["name"] = clean(names.get(session["sessionId"], "")) or session.get("name")
            self.error = ""
        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as exc:
            # Keep showing the last good list, with the failure in the header.
            self.error = f"could not list sessions: {clean(exc)}"
        self.panes = hosted_panes()
        self._notice_new_ids()
        live = {s["sessionId"] for s in self.sessions}
        self.transcripts = {sid: t for sid, t in self.transcripts.items() if sid in live}
        for sid in live:
            self.transcripts.setdefault(sid, Transcript(sid)).poll()

    def _notice_new_ids(self):
        """/clear gives a session a new id but keeps its process, so follow it across the change."""
        current = {s.get("pid"): s["sessionId"] for s in self.sessions}
        changes = [(self.pid_ids[pid], sid) for pid, sid in current.items() if pid in self.pid_ids and self.pid_ids[pid] != sid]
        self.pid_ids = current
        if not changes:
            return
        self.id_changes += changes
        self.retired_ids |= {old for old, _ in changes}
        names = read_names()
        carried = {new: names.pop(old) for old, new in changes if old in names}
        if carried:
            write_names({**names, **carried})
            for session in self.sessions:
                session["name"] = clean(carried.get(session["sessionId"], "")) or session.get("name")

    def take_id_changes(self):
        with self.lock:
            changes, self.id_changes = self.id_changes, []
            return changes

    def human_messages(self, session_id):
        transcript = self.transcripts.get(session_id)
        return transcript.human_messages if transcript else 0

    def last_said(self, session_id):
        transcript = self.transcripts.get(session_id)
        return transcript.text if transcript else ""

    def _update_known(self, sessions):
        """Save the live sessions so they can be offered again after they end or the computer restarts."""
        known = read_known()
        self.remember = known["remember"]
        if not self.remember:
            self.previous = []
            return
        entries, changed, now = known["sessions"], False, time.time()
        for sid in self.retired_ids & set(entries):
            del entries[sid]
            changed = True
        self.retired_ids = set()
        for session in sessions:
            transcript = self.transcripts.get(session["id"])
            if not transcript or not transcript.path:
                continue
            entry = {
                "id": session["id"], "name": session["name"], "cwd": session["cwd"], "title": session["title"],
                "mode": transcript.permission_mode, "path": transcript.path,
            }
            old = entries.get(session["id"], {})
            if {k: old.get(k) for k in entry} != entry or now - old.get("seen", 0) >= KNOWN_TOUCH_SECONDS:
                entries[session["id"]] = {**entry, "seen": now}
                changed = True
        expired = [sid for sid, e in entries.items() if now - e.get("seen", 0) > KNOWN_KEEP_SECONDS]
        for sid in expired + sorted(entries, key=lambda s: entries[s].get("seen", 0))[:-MAX_KNOWN_SESSIONS]:
            changed = entries.pop(sid, None) is not None or changed
        if changed:
            write_known(known)
        live = {s["id"] for s in sessions}
        self.previous = sorted(
            ({k: e.get(k) for k in ("id", "name", "cwd", "title", "seen")}
             for sid, e in entries.items() if sid not in live and os.path.exists(e.get("path", ""))),
            key=lambda e: e["seen"], reverse=True,
        )

    def transcript(self, session):
        return self.transcripts.get(session["sessionId"]) or Transcript(session["sessionId"])

    def snapshot(self):
        """JSON-ready state for the web view, cached so several tabs share one poll."""
        with self.lock:
            if self.cached is None or time.time() - self.cached_at >= SNAPSHOT_MIN_SECONDS:
                self.refresh()
                sessions = [self.session_state(s) for s in self.sessions]
                queue_state = read_queue()
                context_percents, usage = read_status_files()
                for session in sessions:
                    session["queue"] = queue_state["messages"].get(session["id"], [])
                    transcript = self.transcripts.get(session["id"])
                    failure = transcript.failure if transcript else None
                    session["failure"] = None if failure and queue_state["dismissed"].get(session["id"]) == failure["at"] else failure
                    session["retryAt"] = (queue_state["retries"].get(session["id"]) or {}).get("at")
                    session["contextPercent"] = context_percents.get(session["id"])
                self.devices, self.adb = find_devices()
                with self.frames_lock:
                    live = {device["serial"] for device in self.devices}
                    self.frames = {serial: frame for serial, frame in self.frames.items() if serial in live}
                self._update_known(sessions)
                self.cached = {
                    "version": RUNNING_VERSION, "updateReady": script_version() != RUNNING_VERSION,
                    "appVersion": APP_VERSION, "release": releases.offer(),
                    "error": self.error, "sessions": sessions, "devices": self.linked_devices(sessions), "usage": usage,
                    "previous": self.previous, "remember": self.remember,
                }
                self.cached_at = time.time()
            return self.cached

    def session_state(self, session):
        transcript = self.transcript(session)
        quiet = quiet_seconds(transcript)
        started = session.get("startedAt")
        busy = session.get("status") == "busy"
        return {
            "id": session["sessionId"],
            "name": session.get("name") or session["sessionId"][:8],
            "status": session.get("status", "?"),
            "kind": session.get("kind", ""),
            "pid": session.get("pid"),
            "cwd": session.get("cwd", ""),
            "project": os.path.basename(session.get("cwd", "").rstrip("/")),
            "branch": transcript.branch,
            "model": transcript.model,
            "context": format_tokens(transcript.context),
            "up": format_age(time.time() - started / 1000) if started else "-",
            "quiet": int(quiet) if quiet is not None else None,
            "title": transcript.title[:MAX_TEXT],
            "prompt": transcript.prompt[:MAX_TEXT],
            "said": transcript.text[:MAX_TEXT],
            "now": list(transcript.pending.values())[-1][:MAX_TEXT] if busy and transcript.pending else "",
            "actions": [a[:MAX_TEXT] for a in reversed(transcript.actions)],
            "subagents": transcript.subagent_states(),
            "background": self.background_state(session, transcript),
            "job": session.get("id", ""),
            "hosted": session.get("pid") in self.panes,
            "tmux": self.panes.get(session.get("pid")),
            "attention": read_attention(session),
        }

    def background_state(self, session, transcript):
        open_tasks = open_background_tasks()
        live = None if open_tasks is None else open_tasks.get(session["sessionId"], set())
        started = session.get("startedAt")
        now = time.time()
        return [
            {"id": t["id"], "description": t["description"], "running": int(now - t["started"]) if t["started"] else None}
            for t in transcript.background_tasks(live, started / 1000 if started else None)
        ]

    def linked_devices(self, sessions):
        """Devices for the web view, each with every session that started it or named it since it booted.

        There can be several. Telling which one is really using a device isn't possible from
        here, and showing it on an extra session is better than hiding it from the right one.
        """
        names = {s["id"]: s["name"] for s in sessions}
        pids = {s["pid"]: s["id"] for s in sessions}
        result = []
        for device in self.devices:
            starter = pids.get(device["starter_pid"]) or (device["starter"] if device["starter"] in names else None)
            used = {}
            for sid in names:
                transcript = self.transcripts.get(sid)
                if transcript:
                    for source in (transcript, *transcript.subagents.values()):
                        used_at = source.device_uses.get(device["serial"], 0)
                        if used_at and used_at >= device["started"]:
                            used[sid] = max(used.get(sid, 0), used_at)
            linked = []
            if starter:
                linked.append({"id": starter, "name": names[starter], "how": "started"})
            for sid in sorted(used, key=used.get, reverse=True):
                if sid != starter:
                    linked.append({"id": sid, "name": names[sid], "how": "command"})
            result.append({"serial": device["serial"], "label": device["label"], "state": device["state"], "sessions": linked})
        return result

    def device_frame(self, serial):
        """(content type, image) of a device's screen, or None. Viewers of a device share one capture at a time."""
        with self.lock:
            if not any(d["serial"] == serial and d["state"] == "device" for d in self.devices):
                return None  # Also keeps anything but a real serial away from the command line.
            adb = self.adb
        with self.frames_lock:
            frame = self.frames.setdefault(serial, {"lock": threading.Lock(), "at": 0, "gap": FRAME_MIN_SECONDS, "image": None, "jpeg": True})
        with frame["lock"]:
            if time.time() - frame["at"] >= frame["gap"]:
                started, previous = time.time(), frame["image"]
                browser = serial.startswith("browser-")
                # JPEG is several times faster, but only newer system images have it.
                if browser:
                    frame["image"] = capture_browser(int(serial[len("browser-"):]))
                else:
                    frame["image"] = capture_screen(adb, serial, "-j") if frame["jpeg"] else None
                if not frame["image"] and not browser:
                    frame["image"] = capture_screen(adb, serial, "-p")
                    frame["jpeg"] = frame["jpeg"] and not frame["image"]
                frame["at"] = started
                unchanged = frame["image"] is not None and frame["image"] == previous
                frame["gap"] = min(frame["gap"] * FRAME_BACKOFF, FRAME_MAX_SECONDS) if unchanged else FRAME_MIN_SECONDS
            return frame["image"]

    def _history_reader(self, session_id):
        """Reader for a live session, caught up with its transcript. Call with history_lock held."""
        with self.lock:
            transcript = self.transcripts.get(session_id)
            path = transcript.path if transcript else None
        if not path:
            return None
        if not self.history_reader or self.history_reader.path != path:
            self.history_reader = HistoryReader(path)
        self.history_reader.poll()
        return self.history_reader

    def _git_state(self, session_id):
        """What git reports for a session's folder, from a few seconds ago at most."""
        with self.lock:
            cwd = next((s.get("cwd") for s in self.sessions if s["sessionId"] == session_id), None)
            cached = self.git_states.get(cwd)
        if not cwd:
            return None
        if cached and time.monotonic() - cached["at"] < GIT_STATE_SECONDS:
            return cached["state"]
        state = git_uncommitted(cwd)
        with self.lock:
            self.git_states[cwd] = {"at": time.monotonic(), "state": state}
        return state

    def commands(self, session_id):
        """Slash commands for a session: built-ins, its skills, then custom commands. Later ones replace earlier."""
        with self.lock:
            session = next((s for s in self.sessions if s["sessionId"] == session_id), None)
            transcript = self.transcripts.get(session_id)
            path = transcript.path if transcript else None
        if not session:
            return None
        skills = transcript_skills(path) if path else {}
        found = {name: {"name": name, "hint": hint, "description": text, "source": "built-in"} for name, hint, text in BUILTIN_COMMANDS}
        for name, text in skills.items():
            found[name] = {"name": name, "hint": "", "description": clean(text)[:200], "source": "skill"}
        for command in custom_commands(session.get("cwd") or ""):
            found[command["name"]] = command
        return sorted(found.values(), key=lambda c: c["name"])

    def history(self, session_id, limit=HISTORY_LIMIT, since=None):
        """Conversation for a live session, or just {"unchanged"} if it matches revision `since`."""
        # Outside the lock below, so that a slow repository can't hold up other readers.
        git_state = self._git_state(session_id)
        # A separate lock, so a very long transcript's first read doesn't hold up the session list.
        with self.history_lock:
            try:
                reader = self._history_reader(session_id)
                if not reader:
                    # A session that has only just started has no transcript yet.
                    if any(s["sessionId"] == session_id for s in self.sessions):
                        return {"rev": "empty", "messages": [], "omitted": 0, "changes": None}
                    return None
                # Git's answer is part of the revision: files can change with nothing added to the transcript.
                git_revision = git_state["rev"] if git_state else ""
                revision = f"{reader.offset}.{reader.subagent_bytes()}.{limit}.{git_revision}"
                if revision == since:
                    return {"rev": revision, "unchanged": True}
                messages = reader.messages[-limit:]
                changes = reader.changes()
                changes["git"] = other_uncommitted(git_state, changes["files"])
                return {
                    "rev": revision,
                    "messages": messages,
                    "omitted": len(reader.messages) - len(messages),
                    "changes": changes,
                    "requests": reader.request_list(),
                }
            except OSError:
                return None

    def tool_details(self, session_id, tool_id, agent_id=None):
        with self.history_lock:
            try:
                reader = self._history_reader(session_id)
                if reader and agent_id:
                    reader = reader.subagent_reader(agent_id)
                return reader.tool_details(tool_id) if reader else None
            except OSError:
                return None

    def subagents(self, session_id, open_ids, since=None):
        """This session's subagents, or just {"unchanged"} if they match revision `since`."""
        session = next((s for s in self.snapshot()["sessions"] if s["id"] == session_id), None)
        if not session:
            return None
        with self.history_lock:
            try:
                reader = self._history_reader(session_id)
                agents = reader.subagent_summaries(session["subagents"], open_ids) if reader else []
            except OSError:
                return None
        revision = str(hash(json.dumps(agents, sort_keys=True)))
        return {"rev": revision, "unchanged": True} if revision == since else {"rev": revision, "agents": agents}

    def invalidate(self):
        with self.lock:
            self.cached = None

    def current(self, session_id):
        """Up-to-the-moment state of one session, for checks that guard an action."""
        self.invalidate()
        for session in self.snapshot()["sessions"]:
            if session["id"] == session_id:
                return session
        return None

    def summary(self):
        counts = collections.Counter(s.get("status", "?") for s in self.sessions)
        parts = [f"{n} {status}" for status, n in sorted(counts.items())]
        return f"{len(self.sessions)} live" + (" · " + " · ".join(parts) if parts else "")


def usage_window(rate_limits, name):
    window = rate_limits.get(name)
    if not isinstance(window, dict) or not isinstance(window.get("used_percentage"), (int, float)):
        return None
    resets = window.get("resets_at")
    return {"used": window["used_percentage"], "resets": resets if isinstance(resets, (int, float)) else None}


def read_status_files():
    """Figures saved by the status line script: ({session id: context %}, account usage or None).

    Usage limits are per account, so usage comes from whichever session reported most recently.
    """
    percents, usage, newest = {}, None, 0
    try:
        names = os.listdir(STATUS_DIR)
    except OSError:
        return percents, usage
    for name in names:
        path = os.path.join(STATUS_DIR, name)
        if not name.endswith(".json") or name.startswith("."):
            continue
        try:
            modified = os.path.getmtime(path)
            if time.time() - modified > STATUS_KEEP_SECONDS:
                os.unlink(path)
                continue
            with open(path) as handle:
                state = json.load(handle)
        except (OSError, ValueError):
            continue
        if not isinstance(state, dict):
            continue
        if isinstance(state.get("context_percent"), (int, float)):
            percents[name[: -len(".json")]] = state["context_percent"]
        limits = state.get("rate_limits")
        if isinstance(limits, dict) and modified > newest:
            windows = {"five": usage_window(limits, "five_hour"), "seven": usage_window(limits, "seven_day")}
            if windows["five"] or windows["seven"]:
                usage, newest = {**windows, "at": modified}, modified
    return percents, usage


def proc_pids():
    """Process ids from /proc. Windows has no /proc, so the features built on it find nothing there."""
    try:
        return [pid for pid in os.listdir("/proc") if pid.isdigit()]
    except OSError:
        return []


def read_proc(pid, name):
    try:
        with open(f"/proc/{pid}/{name}", "rb") as handle:
            return handle.read()
    except OSError:
        return b""


def process_start_time(pid):
    try:
        # The name in parentheses can contain spaces, so count fields from after it.
        ticks = int(read_proc(pid, "stat").rsplit(b")", 1)[1].split()[19])
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])
        return time.time() - uptime + ticks / os.sysconf("SC_CLK_TCK")
    except (OSError, ValueError, IndexError):
        return 0


def emulator_port(pid, args):
    """Console port from the command line, or from the file the emulator writes for its tools."""
    for flag in ("-port", "-ports"):
        if flag in args[:-1]:
            return args[args.index(flag) + 1].split(",")[0]
    folders = [os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), os.path.expanduser("~/.android")]
    for folder in folders:
        try:
            with open(os.path.join(folder, "avd", "running", f"pid_{pid}.ini")) as handle:
                for line in handle:
                    if line.startswith("port.serial="):
                        return line.split("=", 1)[1].strip()
        except OSError:
            continue
    return None


def android_processes():
    """Running emulators, and the adb binary of the running adb server if there is one."""
    emulators, server = [], None
    for pid in proc_pids():
        comm = read_proc(pid, "comm").strip()
        if comm == b"adb":
            if b"server" in read_proc(pid, "cmdline").split(b"\0"):
                try:
                    server = os.readlink(f"/proc/{pid}/exe")
                except OSError:
                    pass
        elif comm.startswith(b"qemu-system-"):
            try:
                exe = os.readlink(f"/proc/{pid}/exe")
            except OSError:
                continue
            if "/emulator/qemu/" not in exe:
                continue  # Some other QEMU guest, not an Android emulator.
            args = read_proc(pid, "cmdline").decode(errors="replace").split("\0")
            # Inherited by everything a session starts, and unlike the parent process it
            # survives the emulator being backgrounded and re-parented.
            starter, starter_pid = b"", None
            for variable in read_proc(pid, "environ").split(b"\0"):
                if variable.startswith(b"CLAUDE_CODE_SESSION_ID="):
                    starter = variable.split(b"=", 1)[1]
                elif variable.startswith(b"CLAUDE_PID=") and variable[11:].isdigit():
                    starter_pid = int(variable[11:])
            emulators.append({
                "pid": pid,
                "exe": exe,
                "avd": args[args.index("-avd") + 1] if "-avd" in args[:-1] else "",
                "port": emulator_port(pid, args),
                "starter": starter.decode(errors="replace"),
                "starter_pid": starter_pid,
                "started": process_start_time(pid),
            })
    return emulators, server


def find_adb(emulators):
    """An adb to use when no server is running, so no other version can be disturbed."""
    roots = [os.environ.get("ANDROID_HOME"), os.environ.get("ANDROID_SDK_ROOT")]
    candidates = [os.path.join(root, "platform-tools", "adb") for root in roots if root]
    candidates.append(shutil.which("adb"))
    candidates.append(os.path.expanduser("~/Android/Sdk/platform-tools/adb"))
    candidates += [e["exe"].split("/emulator/qemu/")[0] + "/platform-tools/adb" for e in emulators]
    return next((c for c in candidates if c and os.access(c, os.X_OK)), None)


def find_devices():
    """Emulators, adb devices and browsers with a debugging port. Returns (devices, adb path)."""
    devices, adb = find_android_devices()
    return sorted(devices + browser_devices(), key=lambda d: d["serial"]), adb


def session_ancestor(pid):
    """(session id, Claude Code's pid) of the session that started a process, or ("", None).

    Flatpak apps don't keep the environment, so this looks at the process's parents too.
    """
    for _ in range(40):
        starter, starter_pid = b"", None
        for variable in read_proc(pid, "environ").split(b"\0"):
            if variable.startswith(b"CLAUDE_CODE_SESSION_ID="):
                starter = variable.split(b"=", 1)[1]
            elif variable.startswith(b"CLAUDE_PID=") and variable[11:].isdigit():
                starter_pid = int(variable[11:])
        if starter or starter_pid:
            return starter.decode(errors="replace"), starter_pid
        if read_proc(pid, "comm").strip() == b"claude":
            return "", int(pid)
        try:
            pid = read_proc(pid, "stat").rsplit(b")", 1)[1].split()[1].decode()
        except IndexError:
            break
        if pid in ("0", "1"):
            break
    return "", None


def browser_devices():
    """Browsers started with a debugging port. Only the main browser process is counted, once per port."""
    found = {}
    for pid in proc_pids():
        comm = read_proc(pid, "comm").strip()
        if not comm.startswith(BROWSER_NAMES):
            continue
        command = read_proc(pid, "cmdline")
        match = BROWSER_PORT_ARG.search(command)
        if not match or b"--type=" in command:
            continue  # Helper processes, such as renderers, repeat the main one's flags.
        listening = listening_ports(pid)
        port = int(match.group(1)) or devtools_active_port(command) or (min(listening) if len(listening) == 1 else None)
        if not port or port > 65535:
            continue
        # A browser that has hung or is shutting down can keep the flag after letting the port go.
        rank = (port not in listening, process_start_time(pid))
        if port not in found or rank < found[port]["rank"]:
            starter, starter_pid = session_ancestor(pid)
            found[port] = {"rank": rank, "started": rank[1], "starter": starter, "starter_pid": starter_pid}
    devices = []
    for port, browser in found.items():
        page = browser_page(port, CDP_LIST_TIMEOUT_SECONDS)
        title = clean(html.unescape(str(page.get("title") or page.get("url") or ""))) if page else ""
        devices.append({
            "serial": f"browser-{port}",
            "label": ("Browser · " + title if title else "Browser")[:100],
            "state": "device" if page else "starting",
            "kind": "browser",
            **{key: value for key, value in browser.items() if key != "rank"},
        })
    return devices


def devtools_active_port(command):
    """With port 0 the browser picks one, and writes it to a file in its profile folder."""
    for argument in command.split(b"\0"):
        if argument.startswith(b"--user-data-dir="):
            with contextlib.suppress(OSError, ValueError):
                with open(os.path.join(argument.split(b"=", 1)[1].decode(errors="replace"), "DevToolsActivePort")) as handle:
                    return int(handle.readline())
    return None


def listening_ports(pid):
    """The TCP ports a process listens on. A sandboxed browser's port file can't be seen from here, but these can."""
    inodes = set()
    with contextlib.suppress(OSError):
        for fd in os.listdir(f"/proc/{pid}/fd"):
            with contextlib.suppress(OSError):
                link = os.readlink(f"/proc/{pid}/fd/{fd}")
                if link.startswith("socket:["):
                    inodes.add(link[8:-1])
    ports = set()
    for table in ("tcp", "tcp6"):
        for line in read_proc(pid, f"net/{table}").decode(errors="replace").splitlines()[1:]:
            fields = line.split()
            # Fields: number, local address:port, remote, state (0A is listening), ..., inode.
            if len(fields) > 9 and fields[3] == "0A" and fields[9] in inodes:
                ports.add(int(fields[1].rsplit(":", 1)[1], 16))
    return ports


def browser_page(port, timeout):
    """The browser's first open page, as listed by its debugging port, or None."""
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        connection.request("GET", "/json/list")
        response = connection.getresponse()
        targets = json.loads(response.read(MAX_CDP_MESSAGE)) if response.status == 200 else []
    except (OSError, ValueError, http.client.HTTPException):
        return None
    finally:
        connection.close()
    for target in targets if isinstance(targets, list) else []:
        if isinstance(target, dict) and target.get("type") == "page" and not str(target.get("url", "")).startswith(("devtools:", "chrome-extension:")):
            return target
    return None


def read_exactly(stream, count):
    data = stream.read(count)
    if len(data) < count:
        raise OSError("connection closed")
    return data


def cdp_call(port, path, method, params):
    """One DevTools command over a WebSocket, using only the standard library. Returns its result."""
    with socket.create_connection(("127.0.0.1", port), timeout=CDP_TIMEOUT_SECONDS) as sock:
        key = base64.b64encode(os.urandom(16)).decode()
        sock.sendall((
            f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n"
        ).encode())
        stream = sock.makefile("rb")
        if b" 101 " not in stream.readline():
            raise OSError("not accepted")
        while stream.readline() not in (b"\r\n", b""):
            pass
        payload = json.dumps({"id": 1, "method": method, "params": params}).encode()
        header = bytearray([0x81])  # One whole text message.
        if len(payload) < 126:
            header.append(0x80 | len(payload))
        elif len(payload) < 65536:
            header += bytes([0x80 | 126]) + len(payload).to_bytes(2, "big")
        else:
            header += bytes([0x80 | 127]) + len(payload).to_bytes(8, "big")
        mask = os.urandom(4)  # Required from a client, though it hides nothing.
        sock.sendall(bytes(header) + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))
        message = b""
        while True:
            first, second = read_exactly(stream, 2)
            length = second & 0x7F
            if length >= 126:
                length = int.from_bytes(read_exactly(stream, 2 if length == 126 else 8), "big")
            frame_mask = read_exactly(stream, 4) if second & 0x80 else None
            if len(message) + length > MAX_CDP_MESSAGE:
                raise OSError("message too large")
            data = read_exactly(stream, length)
            if frame_mask:
                data = bytes(b ^ frame_mask[i % 4] for i, b in enumerate(data))
            opcode = first & 0x0F
            if opcode == 8:
                raise OSError("closed by the browser")
            if opcode not in (0, 1, 2):
                continue  # Pings: this connection ends long before anything would time out.
            message += data
            if first & 0x80:
                reply = json.loads(message)
                message = b""
                if reply.get("id") == 1:
                    if "error" in reply:
                        raise OSError(str(reply["error"]))
                    return reply.get("result") or {}


def capture_browser(port):
    """(content type, image) of the browser's first page, or None."""
    page = browser_page(port, CDP_TIMEOUT_SECONDS)
    target = urllib.parse.urlsplit(str(page.get("webSocketDebuggerUrl", ""))) if page else None
    # Only ever this browser's own port on this computer, whatever the list says.
    if not target or target.hostname not in ("127.0.0.1", "localhost") or target.port != port:
        return None
    try:
        result = cdp_call(port, target.path, "Page.captureScreenshot", {"format": "jpeg", "quality": 75})
        image = base64.b64decode(result.get("data", ""))
    except (OSError, ValueError, TypeError):
        return None
    return ("image/jpeg", image) if image.startswith(b"\xff\xd8\xff") else None


def find_android_devices():
    """Everything adb can see plus every emulator process. Returns (devices, adb path)."""
    emulators, server = android_processes()
    if not emulators and not server:
        return [], None  # Don't start an adb server just to find nothing.
    # A different adb version would kill the running server, cutting off any test using it.
    adb = server or find_adb(emulators)
    listed = {}
    if adb:
        try:
            output = subprocess.run(
                [adb, "devices", "-l"], capture_output=True, text=True, timeout=ADB_TIMEOUT_SECONDS
            ).stdout
        except (OSError, subprocess.SubprocessError):
            output = ""
        for line in output.splitlines():
            fields = line.split()
            if len(fields) >= 2 and not line.startswith(("*", "List ")):
                models = [f.split(":", 1)[1] for f in fields[2:] if f.startswith("model:")]
                listed[fields[0]] = {"state": fields[1], "model": models[0].replace("_", " ") if models else ""}
    devices = []
    for emulator in emulators:
        serial = f"emulator-{emulator['port']}" if emulator["port"] else f"pid {emulator['pid']}"
        info = listed.pop(serial, None)
        devices.append({
            "serial": serial,
            "label": emulator["avd"].replace("_", " ") or serial,
            "state": info["state"] if info else "starting" if adb else "no adb",
            "starter": emulator["starter"],
            "starter_pid": emulator["starter_pid"],
            "started": emulator["started"],
        })
    for serial, info in listed.items():
        devices.append({"serial": serial, "label": info["model"] or serial, "state": info["state"], "starter": "", "starter_pid": None, "started": 0})
    return sorted(devices, key=lambda d: d["serial"]), adb


def capture_screen(adb, serial, image_flag):
    """(content type, image), or None if the device can't produce that format right now."""
    try:
        result = subprocess.run(
            [adb, "-s", serial, "exec-out", "screencap", image_flag], capture_output=True, timeout=SCREENCAP_TIMEOUT_SECONDS
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    # Check the bytes: an unsupported flag can print its usage text to stdout.
    for signature, content_type in ((b"\xff\xd8\xff", "image/jpeg"), (b"\x89PNG", "image/png")):
        if result.stdout.startswith(signature):
            return content_type, result.stdout
    return None


def read_attention(session):
    """What this session is waiting on, as recorded by the hooks, or None."""
    try:
        with open(os.path.join(ATTENTION_DIR, session["sessionId"] + ".json")) as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        return None
    kind, status = state.get("kind"), session.get("status")
    if status == "busy" or (kind in ("permission", "question") and status != "waiting"):
        return None  # Answered, or it has moved on; the state file clears when the tool finishes.
    if kind == "done" and time.time() - state.get("at", 0) > DONE_BANNER_SECONDS:
        return None
    return {
        "kind": state.get("kind", ""),
        "message": clean(state.get("message", ""))[:MAX_TEXT],
        "at": state.get("at"),
        "ago": int(time.time() - state.get("at", time.time())),
    }


def history_text(value, limit):
    text = HISTORY_CONTROL_CHARS.sub(" ", str(value)).strip()
    if len(text) > limit:
        return text[:limit] + f"\n… ({len(text) - limit} more characters)"
    return text


def tool_result_parts(content):
    """A tool result's (text, images), where each image is a transcript image block."""
    if not isinstance(content, list):
        return str(content or ""), []
    parts, images = [], []
    for block in content:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "image":
            images.append(block)
        else:
            parts.append(block.get("text") or f"[{block.get('type', 'content')}]")
    return "\n".join(parts), images


def preview(text):
    return history_text(text, HISTORY_TOOL_TEXT)


_open_tasks = {"at": 0, "found": None}


def open_background_tasks():
    """Session id -> ids of background tasks whose output file some process still has open.

    None where /proc can't tell (Windows), so callers fall back to the transcript alone.
    """
    if WINDOWS or not os.path.isdir("/proc/self/fd"):
        return None
    if time.time() - _open_tasks["at"] < TASK_SCAN_SECONDS:
        return _open_tasks["found"]
    found = {}
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            fds = os.listdir(f"/proc/{pid}/fd")
        except OSError:
            continue
        for fd in fds:
            try:
                target = os.readlink(f"/proc/{pid}/fd/{fd}")
            except OSError:
                continue
            match = TASK_OUTPUT_FILE.search(target)
            if match:
                found.setdefault(match.group(1), set()).add(match.group(2))
    _open_tasks.update(at=time.time(), found=found)
    return found


def entry_time(entry):
    try:
        return datetime.datetime.fromisoformat(entry["timestamp"]).timestamp()
    except (KeyError, TypeError, ValueError):
        return 0


def shell_requests(command):
    """(method, address) for each request to this computer that a shell command sends.

    Only commands that run curl, wget, HTTPie or xh count. Text being written into a file
    (a heredoc) doesn't, and nor do addresses still holding a variable to fill in.
    """
    lines, marker = [], None
    for line in command.split("\n"):
        if marker:
            marker = None if line.strip() == marker else marker
            continue
        lines.append(line)
        found = HEREDOC.search(line)
        marker = found.group(1) if found else None
    sent = []
    for part in SHELL_SEPARATOR.split("\n".join(lines)):
        if HTTP_COMMAND.match(part):
            method = request_method(part)
            for url in LOCAL_URL.findall(part):
                if "${" not in url and (method, url) not in sent:
                    sent.append((method, url))
    return sent


def request_method(command):
    """The HTTP method a curl, wget or HTTPie command uses, as far as its options show."""
    named = re.search(r"(?:-X|--request|--method)[\s=]*['\"]?([A-Za-z]+)", command)
    if named:
        return named.group(1).upper()
    if re.search(r"\s(?:-d|--data(?:-\w+)?|-F|--form|--json|--post-data|--post-file)\b", command):
        return "POST"
    if re.search(r"\s(?:-I|--head)\b", command):
        return "HEAD"
    return "GET"


def subagent_meta(transcript_path):
    """The details Claude Code saves beside a subagent's transcript."""
    try:
        with open(transcript_path[: -len(".jsonl")] + ".meta.json") as handle:
            meta = json.load(handle)
        return meta if isinstance(meta, dict) else {}
    except (OSError, ValueError):
        return {}


def note_file_change(files, result):
    """Add one edit, as recorded by Claude Code alongside a tool's result, to {path: change}."""
    if not isinstance(result, dict) or not isinstance(result.get("structuredPatch"), list) or not result.get("filePath"):
        return
    hunks = result["structuredPatch"]
    created = result.get("type") == "create"
    if created and not hunks:
        lines = ["+" + line for line in str(result.get("content", "")).split("\n")]
        hunks = [{"oldStart": 0, "newStart": 1, "lines": lines}]
    if not hunks:
        return
    change = files.setdefault(result["filePath"], {
        "path": result["filePath"], "created": created, "added": 0, "removed": 0, "hunks": [], "omittedLines": 0,
    })
    kept = sum(len(hunk["lines"]) for hunk in change["hunks"])
    for hunk in hunks:
        lines = [str(line) for line in hunk.get("lines") or []]
        change["added"] += sum(line.startswith("+") for line in lines)
        change["removed"] += sum(line.startswith("-") for line in lines)
        room = MAX_DIFF_LINES_PER_FILE - kept
        change["omittedLines"] += max(0, len(lines) - room)
        if room > 0:
            change["hunks"].append({"oldStart": hunk.get("oldStart"), "newStart": hunk.get("newStart"), "lines": lines[:room]})
            kept += min(room, len(lines))


def git_uncommitted(cwd):
    """Everything git sees as uncommitted in the repository holding `cwd`, or None if there's no answer."""
    # This repeats while a session page is open, beside sessions that may be running git themselves.
    # No optional locks, so it can't make their commands fail on index.lock. No fsmonitor, which runs a command.
    git = ["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd]
    try:
        root, status = (
            subprocess.run([*git, *args], capture_output=True, text=True, errors="replace", timeout=GIT_TIMEOUT_SECONDS)
            for args in (["rev-parse", "--show-toplevel"], ["status", "--porcelain=v1", "-z"])
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if root.returncode or status.returncode:
        return None
    files = []
    fields = iter(status.stdout.split("\0"))
    for field in fields:
        if len(field) < 4:
            continue
        code = field[:2]
        if "R" in code or "C" in code:
            next(fields, None)  # A rename's old name comes next, as a field of its own.
        conflict = "U" in code or code in ("AA", "DD")
        letter = "U" if conflict else code[1] if code[1] != " " else code[0]
        files.append({"path": field[3:], "status": GIT_STATUS_NAMES.get(letter, "changed")})
    return {"rev": hash(status.stdout), "root": root.stdout.rstrip("\n"), "cwd": os.path.realpath(cwd), "files": files}


def other_uncommitted(state, listed):
    """Git's files, minus those already shown from the transcript, named relative to the session's folder."""
    if not state:
        return None
    shown = {os.path.realpath(change["path"]) for change in listed}
    files = []
    for item in state["files"]:
        path = os.path.join(state["root"], item["path"])
        if os.path.normpath(path) not in shown:
            # Git collapses a wholly untracked folder to one entry, marked by a trailing slash.
            slash = "/" if item["path"].endswith("/") else ""
            files.append({"path": os.path.relpath(path, state["cwd"]) + slash, "status": item["status"]})
    return {"files": files[:MAX_GIT_FILES], "total": len(files)}


class HistoryReader:
    """What was said and done in a transcript, reading only what's been added since last time.

    Long outputs and images are left in the file, with their position noted so that
    tool_details can fetch them on request. This keeps very long sessions light.
    """

    def __init__(self, path, is_subagent=False):
        self.path = path
        self.is_subagent = is_subagent
        self.offset = 0
        self.messages = []
        self.tools = {}
        self.seen = set()
        self.turn = self.new_turn("", 0)
        self.changed_turn = None
        self.previous_turn_at = {}
        self.first_at = 0
        self.agent_readers = {}  # A subagent's transcript path -> its reader.
        self.spawns = {}  # The call that started a subagent -> what Claude said just before it.
        self.instructions = None  # For a subagent: the first message, which is what it was asked to do.
        self.report = ""  # For a subagent: what it handed back when it finished.
        self.requests = []  # Tool rows for shell commands that sent requests to this computer.

    @staticmethod
    def new_turn(prompt, at):
        return {"prompt": prompt, "at": at, "files": {}, "shell": 0}

    def add(self, message):
        message["seq"] = len(self.messages) + 1
        self.messages.append(message)
        return message

    def poll(self):
        if os.path.getsize(self.path) < self.offset:
            self.__init__(self.path, self.is_subagent)
        with open(self.path, "rb") as handle:
            handle.seek(self.offset)
            while True:
                start = handle.tell()
                line = handle.readline()
                if not line.endswith(b"\n"):
                    break  # Nothing more, or a line still being written.
                self.offset = handle.tell()
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if isinstance(entry, dict):
                    self._ingest(entry, start)

    def _human_message(self, text, entry):
        if self.is_subagent and self.instructions is None:
            self.instructions = history_text(text, HISTORY_TEXT)
            return
        command = SLASH_COMMAND.search(text) if text.lstrip().startswith("<command-") else None
        if command:
            # Slash commands are stored as tags. Show them as they were typed.
            arguments = SLASH_ARGS.search(text)
            text = f"{command.group(1)} {arguments.group(1) if arguments else ''}".strip()
        text = history_text(text, HISTORY_TEXT)
        # A message typed while Claude was busy is recorded when queued and again when delivered.
        last = next((m for m in reversed(self.messages) if m["role"] != "tool" and not m.get("note")), None)
        if last and last["role"] == "you" and last["text"] == text:
            return
        self.add({"role": "you", "text": text})
        if self.turn["files"]:
            self.changed_turn = self.turn
        at = entry_time(entry)
        self.previous_turn_at[id(self.turn)] = at
        self.turn = self.new_turn(text, at)

    def _add_note(self, text):
        """A line the terminal shows, kept out of the check for messages recorded twice."""
        if str(text or "").strip():
            self.add({"role": "system", "note": True, "text": history_text(text, HISTORY_TEXT)})

    def _ingest(self, entry, position):
        kind = entry.get("type")
        self.first_at = self.first_at or entry_time(entry)
        if kind == "attachment":
            attachment = entry.get("attachment") or {}
            if attachment.get("type") == "queued_command" and str(attachment.get("prompt", "")).strip():
                origin = attachment.get("origin") if isinstance(attachment.get("origin"), dict) else {}
                if origin.get("kind", "human") == "human":
                    self._human_message(attachment["prompt"], entry)
                else:
                    self.add({"role": "system", "text": history_text(attachment["prompt"], HISTORY_TEXT)})
            elif attachment.get("type") == "hook_system_message":
                self._add_note(attachment.get("content"))
        elif kind == "system":
            subtype = entry.get("subtype")
            if subtype in SHOWN_SYSTEM_NOTES and str(entry.get("content", "")).strip():
                self.add({"role": "system", "text": history_text(entry["content"], HISTORY_TEXT)})
            elif subtype == "turn_duration" and isinstance(entry.get("durationMs"), (int, float)):
                self._add_note("Worked for " + format_age(entry["durationMs"] / 1000))
            elif subtype == "local_command":
                content = str(entry.get("content", ""))
                command = SLASH_COMMAND.search(content)
                output = COMMAND_OUTPUT.search(content)
                self._add_note(command.group(1) if command else output.group(1) if output else content)
        elif kind in ("user", "assistant"):
            self._ingest_message(entry, kind, position)

    def _ingest_message(self, entry, kind, position):
        if entry.get("isMeta") and kind == "user":
            self._note_image_source(entry)
        if (entry.get("isSidechain") and not self.is_subagent) or entry.get("isMeta") or entry.get("uuid") in self.seen:
            return
        if entry.get("uuid"):
            self.seen.add(entry["uuid"])
        content = (entry.get("message") or {}).get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content
        if not isinstance(blocks, list):
            return
        origin = entry.get("origin") if isinstance(entry.get("origin"), dict) else {}
        human = origin.get("kind", "human") == "human" and not entry.get("isCompactSummary")
        for block in blocks:
            if not isinstance(block, dict):
                continue
            block_kind = block.get("type")
            if block_kind == "text" and str(block.get("text", "")).strip():
                if kind == "assistant":
                    role = "system" if entry.get("isApiErrorMessage") else "claude"
                    self.add({"role": role, "text": history_text(block["text"], HISTORY_TEXT)})
                elif human and not str(block["text"]).startswith("[Request interrupted"):
                    self._human_message(block["text"], entry)
                else:
                    self.add({"role": "system", "text": history_text(block["text"], HISTORY_TEXT)})
            elif block_kind == "thinking" and str(block.get("thinking", "")).strip():
                self.add({"role": "thinking", "text": history_text(block["thinking"], HISTORY_TEXT)})
            elif block_kind == "image" and kind == "user":
                self.add({"role": "system", "text": "[An image was attached here]"})
            elif block_kind == "tool_use":
                self._ingest_tool_use(block, position)
            elif block_kind == "tool_result" and block.get("tool_use_id") in self.tools:
                self._ingest_tool_result(block, entry, position)

    def _note_image_source(self, entry):
        """Claude Code follows an attached picture with where it came from. One sent from this app can be shown."""
        content = (entry.get("message") or {}).get("content")
        texts = [content] if isinstance(content, str) else [b.get("text", "") for b in content or [] if isinstance(b, dict)]
        for text in texts:
            match = IMAGE_SOURCE.match(str(text).strip())
            if not match or os.path.dirname(match.group(1)) != uploads_dir():
                continue
            name = os.path.basename(match.group(1))
            note = next((m for m in reversed(self.messages) if m.get("picture") is None and m["text"] == "[An image was attached here]"), None)
            if note is not None and UPLOAD_NAME.match(name):
                note["picture"] = name

    def _stated_reason(self):
        """What Claude said just before starting a subagent, unless other work came between."""
        for message in reversed(self.messages):
            if message["role"] == "claude":
                return message["text"][:MAX_TEXT]
            if message["role"] == "you" or (message["role"] == "tool" and not message.get("starts_agent")):
                return ""
        return ""

    def _ingest_tool_use(self, block, position):
        name = block.get("name", "?")
        if name == "SubagentHandback":
            self.report = history_text((block.get("input") or {}).get("message", ""), HISTORY_TEXT)
            return
        if name == "Bash":
            self.turn["shell"] += 1
        starts_agent = name in AGENT_TOOLS
        if starts_agent:
            self.spawns[block.get("id")] = self._stated_reason()
        tool_input = json.dumps(block.get("input"), indent=1)
        message = self.add({
            "role": "tool",
            "id": block.get("id"),
            "text": describe_tool(name, block.get("input"))[:300],
            "input": preview(tool_input),
            "result": "",
            "error": False,
            "images": 0,
            "more": len(tool_input) > HISTORY_TOOL_TEXT,
            "pending": True,
            "starts_agent": starts_agent,
        })
        self.tools[block.get("id")] = {"message": message, "use_at": position, "result_at": None}
        command = str((block.get("input") or {}).get("command", "")) if name == "Bash" else ""
        sent = shell_requests(command) if command else []
        if sent:
            self.requests.append({"message": message, "method": sent[0][0], "urls": [url for _, url in sent[:5]], "more": len(sent) > 5,
                                  "bare_status": "http_code" in command or "response_code" in command})

    def _ingest_tool_result(self, block, entry, position):
        tool = self.tools[block["tool_use_id"]]
        text, images = tool_result_parts(block.get("content"))
        tool["result_at"] = position
        message = tool["message"]
        message["pending"] = False
        message["result"] = preview(text)
        message["error"] = bool(block.get("is_error"))
        message["images"] = len(images)
        message["more"] = message["more"] or len(text) > HISTORY_TOOL_TEXT or bool(images)
        note_file_change(self.turn["files"], entry.get("toolUseResult"))

    def request_list(self):
        """The latest requests to this computer, with the status code when the output shows one."""
        listed = []
        for request in self.requests[-MAX_REQUESTS:]:
            message = request["message"]
            codes = HTTP_STATUS.findall(message["result"]) or (BARE_STATUS.findall(message["result"]) if request["bare_status"] else [])
            listed.append({
                "seq": message["seq"], "text": message["text"], "method": request["method"], "urls": request["urls"],
                "more": request["more"], "status": codes[-1] if codes else "", "pending": message["pending"],
                "error": message["error"], "result": message["result"],
            })
        return listed

    def _read_entry(self, position):
        with open(self.path, "rb") as handle:
            handle.seek(position)
            return json.loads(handle.readline())

    def tool_details(self, tool_id):
        """A tool call's complete input, output and images, or None if it isn't known."""
        tool = self.tools.get(tool_id)
        if not tool:
            return None
        details = {"input": "", "result": "", "images": []}
        for block in (self._read_entry(tool["use_at"]).get("message") or {}).get("content") or []:
            if isinstance(block, dict) and block.get("id") == tool_id:
                details["input"] = history_text(json.dumps(block.get("input"), indent=1), FULL_TOOL_TEXT)
        if tool["result_at"] is None:
            return details
        for block in (self._read_entry(tool["result_at"]).get("message") or {}).get("content") or []:
            if isinstance(block, dict) and block.get("tool_use_id") == tool_id:
                text, images = tool_result_parts(block.get("content"))
                details["result"] = history_text(text, FULL_TOOL_TEXT)
                for image in images[:MAX_TOOL_IMAGES]:
                    source = image.get("source") or {}
                    # Only known image types go into the page, and only as image data.
                    if source.get("type") == "base64" and source.get("media_type") in IMAGE_TYPES:
                        details["images"].append(f"data:{source['media_type']};base64,{source.get('data', '')}")
        return details

    def subagent_reader(self, agent_id):
        """Reader for one subagent, caught up. The id comes from the page, so it's only matched, never used in a path."""
        for path in self._subagent_paths():
            if os.path.basename(path) == f"agent-{agent_id}.jsonl":
                reader = self.agent_readers.setdefault(path, HistoryReader(path, is_subagent=True))
                reader.poll()
                return reader
        return None

    def subagent_summaries(self, states, open_ids):
        """Why each subagent was started and how it went. Steps are only included for those in `open_ids`."""
        agents = []
        for state in states:
            reader = self.subagent_reader(state["id"])
            if not reader:
                continue
            meta = subagent_meta(reader.path)
            working = state["state"] == "working"
            said = [m["text"] for m in reader.messages if m["role"] == "claude"]
            instructions = reader.instructions or ""
            agent = {
                "id": state["id"],
                "type": state["type"],
                "goal": state["description"] or instructions.strip().split("\n")[0][:MAX_TEXT],
                "instructions": instructions,
                "why": self.spawns.get(meta.get("toolUseId"), ""),
                "state": state["state"],
                "finished": bool(meta.get("finished")),
                "model": clean(meta.get("pickedEffortModel", "")),
                "took": format_age((time.time() if working else os.path.getmtime(reader.path)) - reader.first_at) if reader.first_at else "",
                "now": state["now"] or state["last"] if working else "",
                "report": reader.report or (said[-1] if said and not working else ""),
                "steps": sum(m["role"] == "tool" for m in reader.messages),
            }
            if state["id"] in open_ids:
                agent["messages"] = reader.messages[-MAX_AGENT_STEPS:]
                agent["omitted"] = max(0, len(reader.messages) - MAX_AGENT_STEPS)
            agents.append(agent)
        return agents

    def _subagent_paths(self):
        return glob.glob(os.path.join(glob.escape(self.path[: -len(".jsonl")]), "subagents", "agent-*.jsonl"))

    def subagent_bytes(self):
        total = 0
        for path in self._subagent_paths():
            with contextlib.suppress(OSError):
                total += os.path.getsize(path)
        return total

    def _subagent_changes(self, files, since, until):
        """Add edits made by subagents between two times, since their transcripts are separate."""
        for path in self._subagent_paths():
            with contextlib.suppress(OSError):
                if os.path.getmtime(path) < since:
                    continue
                with open(path, "rb") as handle:
                    for line in handle:
                        # Cheap test first: most lines of a transcript aren't edits.
                        if b"structuredPatch" not in line:
                            continue
                        with contextlib.suppress(ValueError, AttributeError):
                            entry = json.loads(line)
                            if since <= entry_time(entry) and (not until or entry_time(entry) < until):
                                note_file_change(files, entry.get("toolUseResult"))

    def _turn_changes(self, turn, latest):
        files = {path: json.loads(json.dumps(change)) for path, change in turn["files"].items()}
        self._subagent_changes(files, turn["at"], self.previous_turn_at.get(id(turn)))
        return {"prompt": turn["prompt"][:MAX_TEXT], "latest": latest, "shell": turn["shell"], "files": list(files.values())}

    def changes(self):
        """Files changed in the latest turn that changed any, so that replying doesn't empty the list."""
        current = self._turn_changes(self.turn, True)
        if current["files"] or not self.changed_turn:
            return current
        return self._turn_changes(self.changed_turn, False)


def tmux(*args, stdin=None):
    """Run a command on the private tmux server that hosts sessions the app starts."""
    try:
        return subprocess.run(["tmux", "-L", TMUX_SOCKET, *args], input=stdin, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError) as exc:
        return subprocess.CompletedProcess(args, 1, "", clean(exc))


# Sessions the app starts live in a terminal that outlasts the app: a tmux session on Linux,
# a ConPTY in the session host on Windows. These functions are the only way the rest of the
# app reaches them, so the two stay interchangeable.

def hosted_panes():
    """{process id: terminal name} for the app's sessions. A session's own id can change, with
    /clear, so it can't be relied on to match the terminal it started in."""
    panes = {}
    if WINDOWS:
        for item in (host_call("list") or {}).get("sessions", []):
            for pid in item.get("pids", []):
                panes[int(pid)] = item["name"]
        return panes
    result = tmux("list-panes", "-a", "-F", "#{pane_pid} #{session_name}")
    for line in result.stdout.splitlines() if result.returncode == 0 else []:
        pid, _, name = line.partition(" ")
        if pid.isdigit():
            panes[int(pid)] = name
    return panes


def hosted_sessions():
    if WINDOWS:
        return {item["name"] for item in (host_call("list") or {}).get("sessions", [])}
    result = tmux("list-sessions", "-F", "#{session_name}")
    return set(result.stdout.split()) if result.returncode == 0 else set()


def tmux_target(session_id):
    return f"={session_id}:"  # "=" requires an exact name match rather than a prefix.


def session_screen(session_id):
    if WINDOWS:
        screen = (host_call("screen", name=session_id) or {}).get("screen", "")
        return HISTORY_CONTROL_CHARS.sub(" ", screen).strip()
    result = tmux("capture-pane", "-t", tmux_target(session_id), "-p", "-J")
    return HISTORY_CONTROL_CHARS.sub(" ", result.stdout).strip() if result.returncode == 0 else ""


def send_keys(session_id, *keys):
    """Press keys, by tmux's names (Enter, Escape, Up, Down) or as single characters."""
    if WINDOWS:
        return bool((host_call("keys", name=session_id, keys=list(keys)) or {}).get("ok"))
    return tmux("send-keys", "-t", tmux_target(session_id), *keys).returncode == 0


def send_text(session_id, text):
    """Type text as it is, without pressing Enter."""
    if WINDOWS:
        return bool((host_call("text", name=session_id, text=text) or {}).get("ok"))
    return tmux("send-keys", "-t", tmux_target(session_id), "-l", text).returncode == 0


def paste_text(session_id, text):
    """Paste text. Bracketed paste keeps line breaks in it instead of submitting at each one."""
    if WINDOWS:
        return bool((host_call("paste", name=session_id, text=text) or {}).get("ok"))
    buffer = "reply-" + secrets.token_hex(4)
    if tmux("load-buffer", "-b", buffer, "-", stdin=text).returncode != 0:
        return False
    return tmux("paste-buffer", "-p", "-d", "-b", buffer, "-t", tmux_target(session_id)).returncode == 0


def new_terminal(session_id, cwd, command):
    """Start a command in a new hosted terminal. Returns (succeeded, error message)."""
    if WINDOWS:
        reply = host_call("new", start=True, timeout=15, name=session_id, cwd=cwd, command=command)
        if reply is None:
            return False, "The session host didn't start."
        return bool(reply.get("ok")), reply.get("error", "")
    result = tmux("new-session", "-d", "-s", session_id, "-x", str(TERM_COLUMNS), "-y", str(TERM_ROWS), "-c", cwd, "--", *command)
    return result.returncode == 0, clean(result.stderr)


def kill_terminal(session_id):
    if WINDOWS:
        return bool((host_call("kill", name=session_id) or {}).get("ok"))
    return tmux("kill-session", "-t", tmux_target(session_id)).returncode == 0


# ---- The Windows session host ----

HOST_TOKEN_FILE = os.path.join(MONITOR_DIR, "host-token")
TERMINAL_KEYS = {
    "Enter": "\r", "Escape": "\x1b", "Up": "\x1b[A", "Down": "\x1b[B", "Right": "\x1b[C", "Left": "\x1b[D",
    "Tab": "\t", "BSpace": "\x7f", "Space": " ", "C-x": "\x18", "C-s": "\x13",
}


def host_call(op, start=False, timeout=5, **fields):
    """Ask the session host to do something. Returns its reply, or None when it isn't running
    (unless start is set, which starts it) or can't be reached."""
    for attempt in range(2):
        try:
            with open(HOST_TOKEN_FILE) as handle:
                token = handle.read().strip()
            with socket.create_connection(("127.0.0.1", HOST_PORT), timeout=timeout) as connection:
                connection.sendall(json.dumps({"token": token, "op": op, **fields}).encode() + b"\n")
                data = b""
                while not data.endswith(b"\n"):
                    chunk = connection.recv(65536)
                    if not chunk:
                        break
                    data += chunk
            reply = json.loads(data)
            if isinstance(reply, dict) and not reply.get("denied"):
                return reply
        except (OSError, ValueError):
            pass
        if not start or attempt or not start_host():
            return None
    return None


def start_host():
    """Start the session host in the background, apart from this process, and wait until it answers."""
    flags = 0x00000008 | 0x00000200  # DETACHED_PROCESS, CREATE_NEW_PROCESS_GROUP: it outlives the app.
    try:
        subprocess.Popen(own_command("--session-host"), creationflags=flags, close_fds=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    deadline = time.time() + 15
    while time.time() < deadline:
        if host_call("ping"):
            return True
        time.sleep(0.2)
    return False


def windows_process_tree():
    """{parent pid: [child pids]} for every process on this computer."""
    class ProcessEntry(ctypes.Structure):
        _fields_ = [
            ("dwSize", wintypes.DWORD), ("cntUsage", wintypes.DWORD), ("th32ProcessID", wintypes.DWORD),
            ("th32DefaultHeapID", ctypes.c_size_t), ("th32ModuleID", wintypes.DWORD), ("cntThreads", wintypes.DWORD),
            ("th32ParentProcessID", wintypes.DWORD), ("pcPriClassBase", ctypes.c_long), ("dwFlags", wintypes.DWORD),
            ("szExeFile", ctypes.c_wchar * 260),
        ]
    kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
    kernel32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
    kernel32.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
    kernel32.Process32FirstW.argtypes = kernel32.Process32NextW.argtypes = [wintypes.HANDLE, ctypes.POINTER(ProcessEntry)]
    kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
    snapshot = kernel32.CreateToolhelp32Snapshot(0x00000002, 0)  # TH32CS_SNAPPROCESS
    if not snapshot or snapshot == ctypes.c_void_p(-1).value:
        return {}
    children = collections.defaultdict(list)
    try:
        entry = ProcessEntry()
        entry.dwSize = ctypes.sizeof(ProcessEntry)
        found = kernel32.Process32FirstW(snapshot, ctypes.byref(entry))
        while found:
            children[entry.th32ParentProcessID].append(entry.th32ProcessID)
            found = kernel32.Process32NextW(snapshot, ctypes.byref(entry))
    finally:
        kernel32.CloseHandle(snapshot)
    return children


def with_descendants(pid, tree):
    found, waiting = [], [pid]
    while waiting and len(found) < 200:
        current = waiting.pop()
        if current not in found:
            found.append(current)
            waiting += tree.get(current, [])
    return found


class HostedTerminal:
    """One command in a ConPTY, with its screen kept up to date by a terminal emulator (pyte)."""

    def __init__(self, name, cwd, command):
        import pyte
        from winpty import PtyProcess

        class Screen(pyte.Screen):
            def write_process_input(screen, data):
                # Answers to the program's questions about the terminal, such as where the cursor is.
                self.write(data)

        self.name = name
        self.lock = threading.Lock()
        self.ended = False
        self.screen = Screen(TERM_COLUMNS, TERM_ROWS)
        self.stream = pyte.Stream(self.screen)
        program = shutil.which(command[0]) or command[0]
        self.process = PtyProcess.spawn([program, *command[1:]], cwd=cwd, dimensions=(TERM_ROWS, TERM_COLUMNS))
        threading.Thread(target=self.read_output, daemon=True).start()

    def read_output(self):
        while True:
            try:
                data = self.process.read(65536)
            except Exception:  # EOFError when it ends; anything else also means no more output.
                break
            if data:
                with self.lock:
                    self.stream.feed(data)
            elif not self.process.isalive():
                break
        self.ended = True

    def write(self, text):
        try:
            self.process.write(text)
            return True
        except Exception:
            return False

    def alive(self):
        try:
            return not self.ended and self.process.isalive()
        except Exception:
            return False

    def text(self):
        with self.lock:
            return "\n".join(line.rstrip() for line in self.screen.display)

    def kill(self):
        with contextlib.suppress(Exception):
            self.process.terminate(force=True)
        with contextlib.suppress(Exception):
            self.process.close(force=True)
        self.ended = True


def run_session_host():
    """Serve the terminals of sessions the app starts on Windows, until none are left for a while."""
    terminals = {}
    terminals_lock = threading.Lock()
    token = secrets.token_urlsafe(32)
    last_busy = [time.time()]

    def live_terminals():
        with terminals_lock:
            for name in [n for n, t in terminals.items() if not t.alive()]:
                terminals.pop(name).kill()
            if terminals:
                last_busy[0] = time.time()
            return dict(terminals)

    def answer(request):
        op, name = request.get("op"), str(request.get("name", ""))
        if op == "ping":
            return {"ok": True, "version": APP_VERSION}
        if op == "list":
            tree = windows_process_tree()
            return {"ok": True, "sessions": [
                {"name": n, "pids": with_descendants(t.process.pid, tree)} for n, t in live_terminals().items()
            ]}
        if op == "new":
            command = request.get("command")
            if not SESSION_ID.match(name) or not isinstance(command, list) or not command or not all(isinstance(c, str) for c in command):
                return {"ok": False, "error": "Invalid request."}
            cwd = str(request.get("cwd", ""))
            if not os.path.isdir(cwd):
                return {"ok": False, "error": f"No such folder: {cwd}"}
            with terminals_lock:
                if name in terminals:
                    return {"ok": False, "error": "A session with that name is already running."}
                try:
                    terminals[name] = HostedTerminal(name, cwd, command)
                except Exception as exc:
                    return {"ok": False, "error": clean(exc)}
                last_busy[0] = time.time()
            return {"ok": True}
        terminal = live_terminals().get(name)
        if not terminal:
            return {"ok": False, "error": "No such session."}
        if op == "screen":
            return {"ok": True, "screen": terminal.text()}
        if op == "keys":
            keys = request.get("keys")
            if not isinstance(keys, list):
                return {"ok": False, "error": "Invalid request."}
            for key in keys:
                key = str(key)
                if key not in TERMINAL_KEYS and len(key) != 1:
                    return {"ok": False, "error": f"Unknown key: {key}"}
            for key in keys:
                if not terminal.write(TERMINAL_KEYS.get(str(key), str(key))):
                    return {"ok": False, "error": "Could not type into the session."}
                time.sleep(0.02)
            return {"ok": True}
        if op in ("text", "paste"):
            text = str(request.get("text", ""))
            if op == "paste":
                # As tmux pastes: line breaks become carriage returns, inside bracketed-paste markers.
                text = "\x1b[200~" + text.replace("\r\n", "\n").replace("\n", "\r") + "\x1b[201~"
            return {"ok": terminal.write(text)}
        if op == "kill":
            with terminals_lock:
                terminals.pop(name, None)
            terminal.kill()
            return {"ok": True}
        return {"ok": False, "error": "Unknown request."}

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            try:
                request = json.loads(self.rfile.readline(1024 * 1024))
                if not isinstance(request, dict) or not hmac.compare_digest(str(request.get("token", "")).encode(), token.encode()):
                    reply = {"denied": True}
                else:
                    reply = answer(request)
            except Exception as exc:
                reply = {"ok": False, "error": clean(exc)}
            self.wfile.write(json.dumps(reply).encode() + b"\n")

    class Server(socketserver.ThreadingTCPServer):
        allow_reuse_address = False  # On Windows it would let a second host share the port.
        daemon_threads = True

    try:
        server = Server(("127.0.0.1", HOST_PORT), Handler)
    except OSError:
        return 0  # Already running.
    os.makedirs(MONITOR_DIR, exist_ok=True)
    temporary = f"{HOST_TOKEN_FILE}.{os.getpid()}"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        handle.write(token)
    os.replace(temporary, HOST_TOKEN_FILE)

    def exit_when_idle():
        while True:
            time.sleep(5)
            if not live_terminals() and time.time() - last_busy[0] > HOST_IDLE_SECONDS:
                os._exit(0)

    threading.Thread(target=exit_when_idle, daemon=True).start()
    server.serve_forever()
    return 0


def transcript_skills(path):
    """Skill name -> description, from the skill lists Claude Code writes into a transcript.

    The first list is near the start, which the session reader skips in a long transcript,
    so this reads the whole file, looking only at lines that mention a skill list.
    """
    skills = {}
    with contextlib.suppress(OSError):
        with open(path, "rb") as handle:
            for line in handle:
                if b'"skill_listing"' not in line:
                    continue
                with contextlib.suppress(ValueError, AttributeError):
                    attachment = json.loads(line).get("attachment") or {}
                    if attachment.get("type") != "skill_listing" or not isinstance(attachment.get("content"), str):
                        continue
                    if attachment.get("isInitial"):
                        skills = {}  # A complete list. Later ones may only add to it.
                    for text in attachment["content"].split("\n"):
                        match = SKILL_LINE.match(text)
                        if match:
                            skills[match.group(1)] = match.group(2)
    return skills


def custom_commands(cwd):
    """Commands defined as Markdown files, the user's own and then the project's. Subfolders become name:prefixes."""
    found = {}
    for folder, source in ((os.path.join(CONFIG_DIR, "commands"), "your command"), (os.path.join(cwd, ".claude", "commands"), "project command")):
        for path in sorted(glob.glob(os.path.join(glob.escape(folder), "**", "*.md"), recursive=True)):
            name = os.path.relpath(path, folder)[: -len(".md")].replace(os.sep, ":")
            description, hint = "", ""
            with contextlib.suppress(OSError):
                with open(path, encoding="utf-8", errors="replace") as handle:
                    text = handle.read(4000)
                body = text
                if text.startswith("---"):
                    header, _, body = text[3:].partition("\n---")
                    for line in header.split("\n"):
                        key, _, value = line.partition(":")
                        if key.strip() == "description":
                            description = value.strip().strip("'\"")
                        elif key.strip() == "argument-hint":
                            hint = value.strip().strip("'\"")
                description = description or next((l.strip("# ").strip() for l in body.split("\n") if l.strip()), "")
            found[name] = {"name": name, "hint": hint, "description": clean(description)[:200], "source": source}
    return list(found.values())


def menu_options(screen):
    """The answers of the menu Claude Code is showing, or [] if no menu can be read for certain.

    Each is {key, label, description, checked, highlighted}. key is the number to press, or ""
    for an answer without one (the trust menu, a "Submit" line), which is reached by moving the
    highlight. checked is None except on tick-box questions. The highlighted answer is the last
    "❯" line on screen. Claude Code also uses "❯" for the input box, which a menu replaces.
    """
    lines = [line.rstrip() for line in screen.split("\n")]
    while lines and not lines[-1].strip():
        lines.pop()
    here = next((i for i in range(len(lines) - 1, -1, -1) if MENU_HIGHLIGHT.match(lines[i])), None)
    if here is None:
        return []
    # A menu is the last thing on screen, with at most a hint and a divider below it. Anything
    # further up, such as a numbered list in an earlier message, has the input box below it.
    at_bottom = lambda end: sum(1 for line in lines[end + 1:] if line.strip()) <= MENU_BELOW
    numbered = MENU_NUMBERED.match(lines[here])
    if not numbered:
        # No numbers: the answers are the lines around the highlighted one that start in the same column.
        column = MENU_HIGHLIGHT.match(lines[here]).start(2)
        same = lambda line: len(line) - len(line.lstrip()) == column and not line.lstrip().startswith("❯")
        start, end = here, here
        while start > 0 and same(lines[start - 1]):
            start -= 1
        while end + 1 < len(lines) and same(lines[end + 1]):
            end += 1
        return [{"key": "", "label": lines[n].strip().lstrip("❯").strip(), "description": "", "checked": None, "highlighted": n == here}
                for n in range(start, end + 1)] if end > start and at_bottom(end) else []
    # Numbered: answers, their descriptions (indented under the label) and dividers, up and down from the highlight.
    column = numbered.end(1) + 2
    part = lambda line: MENU_NUMBERED.match(line) or MENU_DIVIDER.match(line) or len(line) - len(line.lstrip()) >= column
    start, end = here, here
    while start > 0 and part(lines[start - 1]):
        start -= 1
    while end + 1 < len(lines) and part(lines[end + 1]):
        end += 1
    options = []
    for n in range(start, end + 1):
        line, match = lines[n], MENU_NUMBERED.match(lines[n])
        if match:
            tick = match.group(2)
            options.append({"key": match.group(1), "label": match.group(3), "description": "",
                            "checked": None if tick is None else tick.strip() != "", "highlighted": n == here})
        elif line.strip() == "Submit":
            options.append({"key": "", "label": "Submit", "description": "", "checked": None, "highlighted": n == here})
        elif line.strip() and not MENU_DIVIDER.match(line) and options:
            options[-1]["description"] = (options[-1]["description"] + " " + line.strip()).strip()
    keys = [o["key"] for o in options if o["key"]]
    # Only a clean 1, 2, 3... list counts, so a number is never pressed against something misread.
    return options if keys and keys == [str(k) for k in range(1, len(keys) + 1)] and at_bottom(end) else []


def choose_answer(target, answer, text=None):
    """Pick one answer of the menu on a session's screen: by its number, or by moving the highlight
    onto it and pressing Enter. With text, the answer is "Type something" and the text is typed in."""
    send = lambda *keys: send_keys(target, *keys)
    same = lambda option: option["key"] == answer["key"] and option["label"] == answer["label"]
    if answer["key"] and text is None:
        return send(answer["key"])
    if answer["key"]:
        send(answer["key"])  # This only moves the highlight onto "Type something".
    for _ in range(MENU_STEPS):
        time.sleep(0.15)
        options = menu_options(session_screen(target))
        at = next((n for n, o in enumerate(options) if o["highlighted"]), None)
        to = next((n for n, o in enumerate(options) if same(o)), None)
        if at is None or to is None:
            return False
        if at == to:
            if text is not None and not send_text(target, text):
                return False
            return send("Enter")
        send("Down" if to > at else "Up")
    return False


def live_activity(screen):
    """What the terminal shows above its input box: the status line, and the lines leading up to it.

    Claude Code doesn't record the status line, running output or text still arriving, so the screen
    is the only source. If its layout changes this shows too much or has no heading, and loses nothing.
    """
    lines = [line.rstrip() for line in screen.split("\n")]
    prompt = next((i for i in range(len(lines) - 1, -1, -1) if lines[i].lstrip().startswith("❯")), None)
    if prompt is not None:
        rule = next((i for i in range(prompt - 1, -1, -1) if LIVE_RULE.match(lines[i])), prompt)
        lines = lines[:rule]
    heading = next((i for i in range(len(lines) - 1, -1, -1) if LIVE_STATUS.match(lines[i])), None)
    head = lines.pop(heading).strip() if heading is not None else ""
    shown = []
    in_user_message = False
    for line in lines:
        # The user's messages are in the chat already. On screen, each ends at a blank line.
        in_user_message = line.lstrip().startswith("❯") or (in_user_message and bool(line.strip()))
        # Keyboard hints mean nothing in the app, which can't receive those keys.
        if line.strip() and not in_user_message and "(ctrl+" not in line:
            shown.append(line)
    return {"head": head, "lines": shown[-LIVE_LINES:]}


def trusted_folders():
    """Existing folders Claude Code has been told to trust. The file's format is internal, so this may go empty."""
    folder = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~")
    try:
        with open(os.path.join(folder, ".claude.json")) as handle:
            projects = json.load(handle).get("projects", {})
        return sorted(p for p, state in projects.items() if state.get("hasTrustDialogAccepted") and os.path.isdir(p))
    except (OSError, ValueError, AttributeError):
        return []


def accept_trust_prompt(session_id):
    """Select Yes on Claude Code's trust menu and confirm it. The menu starts on No and its
    order isn't guaranteed, so Enter is only ever pressed with Yes seen to be selected."""
    for _ in range(TRUST_MENU_STEPS):
        screen = session_screen(session_id)
        if TRUST_YES_SELECTED.search(screen):
            return send_keys(session_id, "Enter")
        if not TRUST_YES.search(screen):
            return False
        send_keys(session_id, "Down")
        time.sleep(0.2)
    return False


def start_session(monitor, request):
    """Start a session on the private tmux server. Returns (succeeded, message).

    An untrusted folder is only trusted when the request carries the user's approval of this
    exact path. Otherwise the attempt ends and the user is asked, so no prompt is left waiting.
    """
    cwd = os.path.expanduser(str(request.get("cwd", "")).strip())
    prompt = str(request.get("prompt", "")).strip()
    name = clean(request.get("name", ""))
    mode = str(request.get("mode") or "manual")
    trust_approved = bool(cwd) and request.get("trust") == cwd
    if not os.path.isabs(cwd) or not os.path.isdir(cwd):
        return False, f"Not an existing folder: {cwd or '(empty)'}"
    if not prompt:
        return False, "Enter what the session should do."
    if mode not in NEW_SESSION_MODES:
        return False, f"Permission mode not available here: {mode}"
    session_id = str(uuid.uuid4())
    command = ["claude", "--session-id", session_id, f"--permission-mode={mode}"]
    if name:
        command.append(f"--name={name}")
    command += ["--", prompt]
    return launch_session(monitor, session_id, command, cwd, trust_approved)


def launch_session(monitor, session_id, command, cwd, trust_approved):
    if WINDOWS and os.path.splitext(shutil.which("claude") or "")[1].lower() != ".exe":
        # cmd.exe would read the prompt's &, | and ^ as commands of its own.
        return False, ("On Windows, starting sessions here needs Claude Code's native install (claude.exe). "
                       "An npm install runs through a .cmd file, which can't be given a prompt safely.")
    started, error = new_terminal(session_id, cwd, command)
    if not started:
        return False, f"Could not start the session: {error}"
    trust_answered = False
    deadline = time.time() + START_TIMEOUT_SECONDS
    while time.time() < deadline:
        if monitor.current(session_id):
            return True, "Started."
        if session_id not in hosted_sessions():
            return False, "The session exited right after starting."
        screen = session_screen(session_id)
        if "trust this folder" in screen and not trust_answered:
            if not trust_approved:
                kill_terminal(session_id)
                return False, {"error": "This folder isn't trusted yet.", "needsTrust": True, "cwd": cwd}
            if not accept_trust_prompt(session_id):
                kill_terminal(session_id)
                return False, f"Could not answer the trust prompt. Run claude in {cwd} once and accept it, then retry."
            trust_answered = True
        time.sleep(0.5)
    screen = session_screen(session_id)
    kill_terminal(session_id)
    return False, "The session didn't start in time. Its screen showed: " + clean(screen)[-300:]


def resume_session(monitor, request):
    """Bring back a remembered session, in the permission mode it had."""
    session_id = str(request.get("id", ""))
    with monitor.lock:
        entry = read_known()["sessions"].get(session_id)
    if not entry or not SESSION_ID.match(session_id):
        return False, "That session is no longer remembered."
    if monitor.current(session_id):
        return False, "That session is already running."
    cwd = entry.get("cwd", "")
    if not os.path.isdir(cwd):
        return False, f"Its folder no longer exists: {cwd}"
    # Claude Code records asking first as "default". Anything not offered for new sessions,
    # such as bypassPermissions, also falls back to asking first.
    mode = {"default": "manual"}.get(entry.get("mode"), entry.get("mode"))
    mode = mode if mode in NEW_SESSION_MODES else "manual"
    command = ["claude", "--resume", session_id, f"--permission-mode={mode}"]
    return launch_session(monitor, session_id, command, cwd, bool(cwd) and request.get("trust") == cwd)


def forget_session(monitor, request):
    session_id = str(request.get("id", ""))
    with monitor.lock:
        known = read_known()
        known["sessions"].pop(session_id, None)
        write_known(known)
    return True, "Forgotten."


def set_remember(monitor, request):
    """Turn remembering on or off. Off also clears the list, as the user asked not to keep it."""
    with monitor.lock:
        known = read_known()
        known["remember"] = bool(request.get("on"))
        if not known["remember"]:
            known["sessions"] = {}
        write_known(known)
    return True, "Saved."


def hosted_session(monitor, request):
    """The live app-started session a request names, or None."""
    session = monitor.current(str(request.get("id", "")))
    return session if session and session["hosted"] else None


NOT_HOSTED = "This session wasn't started by the app, so the app can't type into it."


def read_queue():
    """Messages waiting for their session to go idle, and when each session last got one."""
    try:
        with open(QUEUE_FILE) as handle:
            state = json.load(handle)
        return {
            "messages": state["messages"], "sent": state["sent"], "retries": state.get("retries", {}),
            "checks": state.get("checks", {}), "dismissed": state.get("dismissed", {}),
        }
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return {"messages": {}, "sent": {}, "retries": {}, "checks": {}, "dismissed": {}}


def lock_file(handle):
    """Hold an exclusive lock on an open file until it is closed, waiting for it as long as it takes."""
    if not WINDOWS:
        fcntl.flock(handle, fcntl.LOCK_EX)
        return
    while True:
        try:
            msvcrt.locking(handle.fileno(), msvcrt.LK_LOCK, 1)  # Itself retries for about 10 seconds.
            return
        except OSError:
            continue


@contextlib.contextmanager
def queue_locked():
    """Read, change and save the queue. The lock is across processes, because --web and --app
    can both be running and a message must only be delivered once."""
    os.makedirs(MONITOR_DIR, exist_ok=True)
    with open(QUEUE_FILE + ".lock", "w") as lock:
        lock_file(lock)
        state = read_queue()
        try:
            yield state
        finally:
            state["messages"] = {sid: items for sid, items in state["messages"].items() if items}
            state["sent"] = {sid: at for sid, at in state["sent"].items() if time.time() - at < QUEUE_GAP_SECONDS}
            temporary = f"{QUEUE_FILE}.{os.getpid()}"
            with open(temporary, "w") as handle:
                json.dump(state, handle)
            os.replace(temporary, QUEUE_FILE)


def uploads_dir():
    return os.path.join(MONITOR_DIR, "uploads")


def image_type(data):
    if data.startswith(b"\xff\xd8\xff"):
        return "jpg"
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "png"
    if data[:6] in (b"GIF87a", b"GIF89a"):
        return "gif"
    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "webp"
    return None


def save_upload(monitor, request):
    """Keep a picture the page sent, for a message to attach. Returns its name."""
    try:
        data = base64.b64decode(str(request.get("data", "")), validate=True)
    except ValueError:
        return False, "That picture couldn't be read."
    kind = image_type(data)
    if not kind:
        return False, "Only JPEG, PNG, GIF and WebP pictures can be sent."
    if len(data) > MAX_UPLOAD_BYTES:
        return False, "That picture is too large."
    folder = uploads_dir()
    os.makedirs(folder, mode=0o700, exist_ok=True)
    cutoff = time.time() - UPLOAD_KEEP_DAYS * 86400
    for old in os.listdir(folder):
        path = os.path.join(folder, old)
        with contextlib.suppress(OSError):
            if UPLOAD_NAME.match(old) and os.path.getmtime(path) < cutoff:
                os.remove(path)
    name = f"{secrets.token_hex(16)}.{kind}"
    descriptor = os.open(os.path.join(folder, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0), 0o600)
    with os.fdopen(descriptor, "wb") as handle:
        handle.write(data)
    return True, {"name": name}


def upload_path(name):
    """The file of an uploaded picture, or None if the name isn't one."""
    if not isinstance(name, str) or not UPLOAD_NAME.match(name):
        return None
    path = os.path.join(uploads_dir(), name)
    return path if os.path.isfile(path) else None


def type_into(session, text, images=()):
    """Type a message into the input box without sending it. Each picture's path is pasted on
    its own, which is what makes Claude Code attach it as an image rather than leave it as text."""
    if text and not paste_text(session["tmux"], text + ("\n" if images else "")):
        return False
    for name in images:
        time.sleep(0.2)
        if not paste_text(session["tmux"], os.path.join(uploads_dir(), name)):
            return False
    time.sleep(0.5 if images else 0.2)  # Claude Code reads each picture before Enter counts.
    return True


def type_message(session, text, images=()):
    """Paste a message into a session and submit it. Returns (succeeded, message)."""
    if not type_into(session, text, images):
        return False, "Could not type into the session."
    send_keys(session["tmux"], "Enter")
    return True, "Sent."


def input_box(screen):
    """The text in Claude Code's input box, or None unless the box is showing and no menu is.

    The box is a "❯" line with a divider right above it and another below it, near the bottom.
    A suggestion Claude Code shows there in grey reads as text too, and is replaced by typing.
    """
    if menu_options(screen):
        return None
    lines = [line.rstrip() for line in screen.split("\n")]
    while lines and not lines[-1].strip():
        lines.pop()
    for i in range(len(lines) - 1, max(0, len(lines) - INPUT_BOX_SEARCH_LINES), -1):
        if lines[i].lstrip().startswith("❯") and LIVE_RULE.match(lines[i - 1]):
            end = next((j for j in range(i + 1, len(lines)) if LIVE_RULE.match(lines[j])), None)
            if end is None or sum(1 for line in lines[end + 1:] if line.strip()) > INPUT_BOX_BELOW:
                return None
            return "\n".join(line.strip() for line in lines[i:end]).lstrip("❯").strip()
    return None


def send_queued_now(monitor, request):
    """Type a queued message into a working session's own input box, as typing in its terminal would.

    That puts it in Claude Code's own queue, then Ctrl+X Ctrl+S sends it straight away, as Claude
    Code's own "send now" does, interrupting what Claude is doing. A busy session can raise a menu
    at any moment, where Enter would pick an answer, so the box is checked just before typing and
    again before each key.
    """
    with queue_locked() as state:
        session = hosted_session(monitor, request)
        if not session:
            return False, NOT_HOSTED
        items = state["messages"].get(session["id"], [])
        item = next((i for i in items if i["id"] == request.get("item")), None)
        if not item:
            return False, "That message has already been sent."
        if item.get("refresh") or item.get("retry") or item.get("guard"):
            return False, "That step only runs once the session is idle."
        if item["text"].startswith("/"):
            return False, "Commands only run once the session is idle, so it stays queued."
        if session["status"] == "waiting":
            return False, "It's waiting for an answer. Answer it first, then send this."
        if session["status"] == "busy":
            before = input_box(session_screen(session["tmux"]))
            if before is None:
                return False, "Its input box isn't showing right now, so nothing was typed. Try again in a moment."
            if not type_into(session, item["text"], item.get("images", [])):
                return False, "Could not type into the session."
            time.sleep(0.1)
            after = input_box(session_screen(session["tmux"]))
            if after is None or after == before:
                items.remove(item)
                items.insert(0, {**item, "error": "Something appeared on its screen while typing, so Enter wasn't pressed. "
                                 "The text may still be in its input box, so check the terminal before retrying."})
                return False, "It wasn't sent. Check the session's terminal."
            send_keys(session["tmux"], "Enter")
            # Now in Claude Code's queue, where Claude would get it at its next step. Send it now instead,
            # unless something has taken the screen, in which case it's left in that queue.
            time.sleep(0.3)
            if input_box(session_screen(session["tmux"])) is not None:
                send_keys(session["tmux"], "C-x")
                send_keys(session["tmux"], "C-s")
            state["sent"][session["id"]] = time.time()
            state["checks"][session["id"]] = {"text": item["text"], "images": item.get("images", []), "count": monitor.human_messages(session["id"]), "at": time.time()}
        else:
            succeeded, message = send_tracked(monitor, session, item["text"], state, item.get("images", []))
            if not succeeded:
                return False, message
        items.remove(item)
        return True, "Sent."


def may_type_now(session, state):
    # A stray Enter on a permission menu approves it, and a busy session could raise one at
    # any moment, so text is only ever typed into a session that is idle.
    return session["status"] == "idle" and time.time() - state["sent"].get(session["id"], 0) >= QUEUE_GAP_SECONDS


def send_tracked(monitor, session, text, state, images=()):
    """Type a message and note what's needed to tell later whether it arrived."""
    before = monitor.human_messages(session["id"])
    succeeded, message = type_message(session, text, images)
    if succeeded:
        state["sent"][session["id"]] = time.time()
        if not text.startswith("/"):  # Slash commands aren't recorded as messages.
            state["checks"][session["id"]] = {"text": text, "images": list(images), "count": before, "at": time.time()}
    return succeeded, message


def send_reply(monitor, request):
    """Send a message now if the session is free, otherwise add it to the end of its queue."""
    text = HISTORY_CONTROL_CHARS.sub(" ", str(request.get("text", ""))).strip()
    images = request.get("images") or []
    if not isinstance(images, list) or len(images) > MAX_IMAGES:
        return False, f"Up to {MAX_IMAGES} pictures can go in one message."
    if not all(upload_path(name) for name in images):
        return False, "A picture is no longer available. Remove it and add it again."
    if not text and not images:
        return False, "Type a message first."
    if text.startswith("/") and images:
        return False, "Pictures can't go with a command."
    if len(text.encode()) > MAX_REPLY_BYTES:
        return False, "That message is too long."
    with queue_locked() as state:
        session = hosted_session(monitor, request)
        if not session:
            return False, NOT_HOSTED
        items = state["messages"].setdefault(session["id"], [])
        item = {"id": secrets.token_hex(8), "text": text, **({"images": images} if images else {})}
        if not items and may_type_now(session, state):
            succeeded, message = send_tracked(monitor, session, text, state, images)
            if succeeded:
                return True, message
            # Keep it, where it can be retried, instead of leaving it to be lost from the box.
            items.append({**item, "error": message})
            return True, "Couldn't send it, so it's kept in the queue."
        if len(items) >= MAX_QUEUED:
            return False, "Too many messages are already queued for this session."
        items.append(item)
        return True, "Queued."


RETRY_PROMPT = """Your last request failed before you could finish it ({reason}). Please carry on with it now."""


def retry_failed(monitor, request):
    """Act on the API error that ended a session's last turn: retry now or at reset, cancel, or dismiss."""
    action = request.get("action")
    with queue_locked() as state:
        session = hosted_session(monitor, request) if action != "dismiss" else monitor.current(str(request.get("id", "")))
        if not session:
            return False, NOT_HOSTED
        failure = session["failure"]
        if action == "cancel":
            state["retries"].pop(session["id"], None)
            return True, "Cancelled."
        if not failure:
            return False, "That has already been dealt with."
        if action == "dismiss":
            state["dismissed"][session["id"]] = failure["at"]
            state["retries"].pop(session["id"], None)
        elif action == "now":
            state["retries"].pop(session["id"], None)
            items = state["messages"].setdefault(session["id"], [])
            if not any(i.get("retry") for i in items):
                items.insert(0, retry_item(failure))
        elif action == "reset":
            if not failure["resets"] or failure["resets"] < time.time():
                return False, "There's no upcoming reset to wait for, so try it now."
            state["retries"][session["id"]] = {"at": failure["resets"] + RETRY_GRACE_SECONDS, "failure": failure["at"]}
        else:
            return False, "Unknown action."
    return True, "Done."


def retry_item(failure):
    # The failed message is still part of the conversation, so asking it to carry on avoids
    # sending it twice, and doesn't restart work if the failure came partway through a task.
    return {"id": secrets.token_hex(8), "retry": True, "label": "Retry the failed request", "text": RETRY_PROMPT.format(reason=failure["message"])}


def resend_queued(monitor, request):
    """Clear the error on a queued message that couldn't be sent, so it's tried again."""
    with queue_locked() as state:
        for item in state["messages"].get(str(request.get("id", "")), []):
            if item["id"] == request.get("item"):
                item.pop("error", None)
                return True, "Trying again."
    return False, "That message has already been sent."


def remove_queued(monitor, request):
    with queue_locked() as state:
        items = state["messages"].get(str(request.get("id", "")), [])
        for item in items:
            if item["id"] == request.get("item"):
                if item.get("refresh"):
                    # Its steps only make sense together, so they're cancelled together.
                    items[:] = [i for i in items if not i.get("refresh")]
                else:
                    items.remove(item)
                return True, "Removed."
    return False, "That message has already been sent."


SAVE_PROMPT = """Before this chat is cleared, save your progress so a fresh session can pick up exactly where you are. \
Update this project's existing notes, such as HANDOFF.md, a progress report or CLAUDE.md, or create HANDOFF.md if there are none. \
Cover what's done, what's in progress, decisions made and why, what's next, and the exact commands needed. \
Don't start new work, and don't commit anything just for this. \
Only once the notes are written, end your reply with exactly this code: {code}
If you couldn't save them, say why and leave the code out, because the chat is only cleared if the code is there."""
CONTINUE_PROMPT = """This chat was just cleared to keep context small, and your progress was saved first. \
Read this project's documentation and progress notes, such as CLAUDE.md, HANDOFF.md and any progress reports, then continue where the last session left off. \
If the notes say something is waiting on me, ask me instead of guessing."""


def save_and_refresh(monitor, request):
    """Queue the three steps: save progress, clear the chat if that worked, then carry on from the notes."""
    session = hosted_session(monitor, request)
    if not session:
        return False, NOT_HOSTED
    code = "PROGRESS-SAVED-" + secrets.token_hex(4)
    with queue_locked() as state:
        items = state["messages"].setdefault(session["id"], [])
        # Trying again replaces an earlier attempt, including one that stopped with an error.
        items[:] = [i for i in items if not i.get("refresh")]
        items += [
            {"id": secrets.token_hex(8), "refresh": True, "label": "Write notes", "text": SAVE_PROMPT.format(code=code)},
            {"id": secrets.token_hex(8), "refresh": True, "label": "Clear the chat, if progress was saved", "text": "/clear", "guard": code},
            {"id": secrets.token_hex(8), "refresh": True, "label": "Read the docs and continue", "text": CONTINUE_PROMPT},
        ]
    return True, "Queued."


def settle_retries_and_checks(state, sessions, monitor):
    """Start retries that have come due, and flag messages that were typed but never arrived."""
    now = time.time()
    for session_id, retry in list(state["retries"].items()):
        session = sessions.get(session_id)
        failure = session and session["failure"]
        if not failure or failure["at"] != retry["failure"]:
            del state["retries"][session_id]  # It ended, or has moved on by itself.
        elif now >= retry["at"]:
            del state["retries"][session_id]
            state["messages"].setdefault(session_id, []).insert(0, retry_item(failure))
    for session_id, check in list(state["checks"].items()):
        if session_id not in sessions or monitor.human_messages(session_id) > check["count"]:
            del state["checks"][session_id]
        elif now - check["at"] >= ARRIVAL_TIMEOUT_SECONDS:
            del state["checks"][session_id]
            state["messages"].setdefault(session_id, []).insert(0, {
                "id": secrets.token_hex(8), "text": check["text"], "error": "It was typed in, but never reached the session.",
                **({"images": check["images"]} if check.get("images") else {}),
            })
    state["dismissed"] = {sid: at for sid, at in state["dismissed"].items() if sid in sessions}


def deliver_queued(monitor):
    """Send the next message of each session that has gone idle, and drop those of ended sessions."""
    waiting = read_queue()
    if not (waiting["messages"] or waiting["retries"] or waiting["checks"]):
        monitor.take_id_changes()
        return
    snapshot = monitor.snapshot()
    if snapshot["error"]:
        return  # The session list may be out of date, so don't act on it.
    changes = monitor.take_id_changes()
    if changes:
        # After /clear the session has a new id, and its queue goes with it.
        with queue_locked() as state:
            for old, new in changes:
                if old in state["messages"]:
                    state["messages"][new] = state["messages"].pop(old) + state["messages"].get(new, [])
                if old in state["sent"]:
                    state["sent"][new] = state["sent"].pop(old)
                state["checks"].pop(old, None)
    sessions = {s["id"]: s for s in snapshot["sessions"]}
    with queue_locked() as state:
        settle_retries_and_checks(state, sessions, monitor)
    for session_id in read_queue()["messages"]:
        if session_id in sessions and sessions[session_id]["status"] != "idle":
            continue
        with queue_locked() as state:
            items = state["messages"].get(session_id)
            if not items:
                continue
            if session_id not in sessions:
                del state["messages"][session_id]
                continue
            # Answers "still idle?" from a fresh listing, as the check above may be seconds old.
            session = hosted_session(monitor, {"id": session_id})
            if not session or items[0].get("error") or not may_type_now(session, state):
                continue
            if items[0].get("retry") and not session["failure"]:
                items.pop(0)  # It has already moved on, so there's nothing to retry.
                continue
            if session["failure"] and not items[0].get("retry"):
                continue  # Otherwise each message would hit the same error, one after another.
            guard = items[0].get("guard")
            if guard and guard not in monitor.last_said(session_id):
                items[0]["error"] = "It didn't confirm that its progress was saved, so the chat wasn't cleared."
                continue
            succeeded, message = send_tracked(monitor, session, items[0]["text"], state, items[0].get("images", []))
            if succeeded:
                items.pop(0)
            else:
                # Not retried automatically: part of it may have been typed already.
                items[0]["error"] = message


def run_queue_delivery(monitor):
    while True:
        time.sleep(QUEUE_POLL_SECONDS)
        try:
            deliver_queued(monitor)
        except Exception as exc:  # This thread has to outlive any one failure.
            print(f"claude-monitor: queue delivery failed: {clean(exc)}", file=sys.stderr, flush=True)


def press_key(monitor, request):
    session = hosted_session(monitor, request)
    if not session:
        return False, NOT_HOSTED
    action = str(request.get("action", ""))
    status, attention = session["status"], session["attention"] or {}
    is_permission = status == "waiting" and attention.get("kind") == "permission"
    if action in ("choose", "type"):
        # Tied to the prompt that was on screen, so it can't land on a newer one.
        if status != "waiting" or attention.get("at") != request.get("prompt"):
            return False, "That prompt is no longer waiting. Check the screen and try again."
        # Checked against the menu as it is now, so an answer is only picked where it means the same thing.
        key, label = str(request.get("key", "")), request.get("label")
        options = menu_options(session_screen(session["tmux"]))
        answer = next((o for o in options if o["key"] == key and o["label"] == label), None)
        if not answer:
            return False, "Those answers are no longer showing. Check the screen and try again."
        text = None
        if action == "type":
            text = CONTROL_CHARS.sub(" ", str(request.get("text", ""))).strip()
            if not TYPE_SOMETHING.match(answer["label"]) or not text or any(o["checked"] is not None for o in options):
                return False, "That answer can't take typed text here."
        if not choose_answer(session["tmux"], answer, text):
            return False, "Could not pick that answer. Check the screen and try again."
        return True, "Sent."
    if action in ("approve", "deny"):
        # Tied to the prompt that was on screen, so it can't land on a newer one.
        if not is_permission or attention.get("at") != request.get("prompt"):
            return False, "That prompt is no longer waiting. Check the screen and try again."
        key = "1" if action == "approve" else "Escape"  # Option 1 is always Yes.
    elif action == "interrupt":
        if status != "busy":
            return False, "It isn't working on anything right now."
        key = "Escape"
    elif action in ("up", "down", "enter", "escape"):
        if status != "waiting" or (is_permission and action != "escape"):
            return False, "That prompt is no longer waiting."
        key = {"up": "Up", "down": "Down", "enter": "Enter", "escape": "Escape"}[action]
    else:
        return False, "Unknown action."
    if not send_keys(session["tmux"], key):
        return False, "Could not reach the session."
    return True, "Sent."


def end_session(monitor, request):
    session = hosted_session(monitor, request)
    if not session:
        return False, NOT_HOSTED
    if not kill_terminal(session["tmux"]):
        return False, "Could not end the session."
    # Ending it was deliberate, so it isn't offered again as if it had been interrupted.
    forget_session(monitor, request)
    return True, "Ended."


def open_terminal(monitor, request):
    session = monitor.current(str(request.get("id", "")))
    if not session:
        return False, "That session is no longer running."
    if session["hosted"] and WINDOWS:
        return False, "On Windows, sessions started here can only be used from this app."
    if session["hosted"]:
        command = ["tmux", "-L", TMUX_SOCKET, "attach-session", "-t", tmux_target(session["tmux"])]
    elif session["job"]:
        command = ["claude", "attach", session["job"]]
    else:
        return False, "This session is already in its own terminal window."
    if WINDOWS:
        subprocess.Popen(["cmd.exe", "/k", *command], creationflags=0x00000010)  # CREATE_NEW_CONSOLE
        return True, "Opened."
    for program, flag in (("konsole", "-e"), ("gnome-terminal", "--"), ("x-terminal-emulator", "-e")):
        if shutil.which(program):
            environment = {k: v for k, v in os.environ.items() if k != "TMUX"}
            subprocess.Popen([program, flag, *command], env=environment, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True, "Opened."
    return False, "No terminal program was found."


def rename_session(monitor, request):
    """Set or, with an empty name, clear the display name the monitor shows for a session."""
    session_id = str(request.get("id", ""))
    name = clean(request.get("name", ""))[:MAX_NAME]
    if not monitor.current(session_id):
        return False, "That session is no longer running."
    with monitor.lock:
        names = read_names()
        if name:
            names[session_id] = name
        else:
            names.pop(session_id, None)
        write_names(names)
    return True, "Renamed."


def restart_server():
    """Replace this process with the current code. Sessions live in tmux, and the app window is
    a separate process, so both carry on. The queue lock makes sure no message is mid-delivery."""
    arguments = [a for a in sys.argv[1:]]
    if "--browser-pid" in arguments:
        at = arguments.index("--browser-pid")
        del arguments[at:at + 2]
    if attached_browser_pid:
        arguments += ["--browser-pid", str(attached_browser_pid)]
    elif "--no-open" not in arguments:
        arguments.append("--no-open")
    with queue_locked():
        if WINDOWS:
            # Windows can't replace a running process, so start the new one and leave. It waits for
            # this one's port, and the session host and app window carry on as they are.
            subprocess.Popen(own_command(*arguments, "--wait-for-port"), close_fds=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            os._exit(0)
        command = own_command(*arguments)
        os.execv(command[0], command)


def restart_app(monitor, request):
    # Checked first: a file saved mid-edit would otherwise leave no server to come back to.
    try:
        if not FROZEN:
            with open(SCRIPT_PATH, encoding="utf-8") as handle:
                compile(handle.read(), SCRIPT_PATH, "exec")
    except (OSError, SyntaxError, ValueError) as exc:
        return False, f"The new version can't start, so this one is staying up: {clean(exc)}"
    threading.Timer(0.3, restart_server).start()  # After this request has been answered.
    return True, "Restarting."


def version_tuple(text):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)", str(text or "").strip())
    return tuple(int(n) for n in match.groups()) if match else None


def fetch(url, limit, timeout=30):
    """Download at most limit bytes over HTTPS (or plain HTTP to this computer, for tests)."""
    parts = urllib.parse.urlparse(url)
    if parts.scheme != "https" and parts.hostname not in ("127.0.0.1", "localhost"):
        raise ValueError(f"refusing to download from {url}")
    request = urllib.request.Request(url, headers={"User-Agent": "claude-sessions-updater", "Accept": "application/vnd.github+json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError("the download is larger than expected")
    return data


class Releases:
    """Watches GitHub for a newer release of this app, and installs it when asked."""

    def __init__(self):
        self.latest = None
        self.lock = threading.Lock()

    def check(self):
        release = json.loads(fetch(RELEASES_URL, 1024 * 1024))
        assets = {a.get("name"): a.get("browser_download_url") for a in release.get("assets", []) if isinstance(a, dict)}
        version = str(release.get("tag_name", "")).lstrip("v")
        if version_tuple(version) and assets.get(RELEASE_ASSET) and assets.get("SHA256SUMS"):
            self.latest = {"version": version, "url": assets[RELEASE_ASSET], "sums": assets["SHA256SUMS"],
                           "page": str(release.get("html_url", ""))}

    def watch(self):
        while True:
            try:
                self.check()
                time.sleep(RELEASE_CHECK_SECONDS)
            except Exception:  # Offline, rate-limited or a surprise reply: try again later.
                time.sleep(RELEASE_RETRY_SECONDS)

    def offer(self):
        """The newer release, if there is one and this copy came from a release itself."""
        latest, mine = self.latest, version_tuple(APP_VERSION)
        if latest and mine and version_tuple(latest["version"]) > mine:
            return {"version": latest["version"], "page": latest["page"]}
        return None

    def install(self):
        """Download the newer release over this app's own file. Returns (succeeded, message)."""
        if not self.lock.acquire(blocking=False):
            return False, "An update is already being installed."
        try:
            latest = self.latest
            if not self.offer():
                return False, "There is no newer version to install."
            sums = {}
            for line in fetch(latest["sums"], 64 * 1024).decode(errors="replace").splitlines():
                digest, _, name = line.strip().partition(" ")
                sums[name.strip().lstrip("*")] = digest.lower()
            expected = sums.get(RELEASE_ASSET)
            if not expected:
                return False, "The release has no checksum for this app, so it wasn't installed."
            data = fetch(latest["url"], MAX_DOWNLOAD_BYTES, timeout=300)
            if not hmac.compare_digest(hashlib.sha256(data).hexdigest(), expected):
                return False, "The download didn't match its checksum, so it wasn't installed."
            if not WINDOWS:
                compile(data, PROGRAM_PATH, "exec")  # A broken script would leave no app to come back to.
            downloaded = PROGRAM_PATH + ".download"
            with open(downloaded, "wb") as handle:
                handle.write(data)
            if WINDOWS:
                # A running program can't be overwritten on Windows, but it can be moved out of the way.
                previous = PROGRAM_PATH + ".old"
                with contextlib.suppress(OSError):
                    os.unlink(previous)
                os.replace(PROGRAM_PATH, previous)
                try:
                    os.replace(downloaded, PROGRAM_PATH)
                except OSError:
                    os.replace(previous, PROGRAM_PATH)
                    raise
            else:
                os.chmod(downloaded, os.stat(PROGRAM_PATH).st_mode | 0o111)
                os.replace(downloaded, PROGRAM_PATH)
            return True, f"Installed version {latest['version']}."
        except (OSError, ValueError, SyntaxError) as exc:
            with contextlib.suppress(OSError):
                os.unlink(PROGRAM_PATH + ".download")
            return False, f"The update failed: {clean(exc)}"
        finally:
            self.lock.release()


releases = Releases()


def update_app(monitor, request):
    succeeded, message = releases.install()
    if succeeded:
        threading.Timer(0.3, restart_server).start()  # After this request has been answered.
    return succeeded, message



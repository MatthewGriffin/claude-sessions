                self.respond(403, "text/plain", b"forbidden")
                return
            action = POST_ROUTES.get(self.path)
            if not action:
                self.respond(404, "text/plain", b"not found")
                return
            try:
                length = int(self.headers.get("Content-Length", 0))
                if not 0 < length <= (UPLOAD_REQUEST_BYTES if action is save_upload else 65536):
                    raise ValueError
                request = json.loads(self.rfile.read(length))
                if not isinstance(request, dict):
                    raise ValueError
            except ValueError:
                self.send_json(400, {"error": "Invalid request."})
                return
            succeeded, message = action(monitor, request)
            monitor.invalidate()
            failure = message if isinstance(message, dict) else {"error": message}
            self.send_json(200 if succeeded else 400, {"message": message} if succeeded else failure)

        def log_message(self, *args):
            pass

    try:
        server = bind_server(port, Handler)
        threading.Thread(target=releases.watch, daemon=True).start()
        threading.Thread(target=run_queue_delivery, args=(monitor,), daemon=True).start()
    except OSError as exc:
        if app_browser_command:
            # Already open: this browser profile holds the cookie, so no code is needed.
            return open_app_window(app_browser_command, f"http://127.0.0.1:{port}/")
        sys.exit(f"claude-monitor: cannot use port {port} ({exc}); try --port N\nIf it's already running, open: {url}")
    if app_browser_command:
        threading.Thread(target=server.serve_forever, daemon=True).start()
        attached_browser_pid = browser_pid or start_app_window(app_browser_command, app_url).pid
        code = wait_for_window()
        server.shutdown()
        return code
    print(f"Claude sessions monitor: {url}   (Ctrl+C to stop)", flush=True)
    if open_browser:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


HOOK_EVENTS = ("PermissionRequest", "Notification", "Stop", "UserPromptSubmit", "PostToolUse", "PostToolUseFailure", "SessionEnd")
SETTINGS_FILE = os.path.join(CONFIG_DIR, "settings.json")
WINDOWS_INSTALL_DIR = os.path.join(os.environ.get("LOCALAPPDATA", ""), "Programs", "Claude Sessions")


def command_line(arguments):
    """A command for Claude Code to run, as text. Forward slashes and quotes work in both bash and cmd."""
    quoted = []
    for argument in arguments:
        if WINDOWS:
            argument = argument.replace("\\", "/")
        quoted.append(f'"{argument}"' if (WINDOWS or " " in argument) and not argument.startswith("--") else argument)
    return " ".join(quoted)


def own_command_line(*arguments):
    # The script runs by itself through its #! line, which keeps the hook command short.
    return command_line([SCRIPT_PATH, *arguments] if not FROZEN and not WINDOWS else own_command(*arguments))


def icon_svg():
    """The app's icon, taken from the page's own."""
    match = re.search(r'<link rel="icon" href="data:image/svg\+xml,([^"]+)"', PAGE)
    return urllib.parse.unquote(match.group(1)) if match else ""


def run_setup(verbose=True):
    """Add this app's hooks to Claude Code, and its status line if there is none. Leaves everything else as it is."""
    say = print if verbose and sys.stdout else (lambda *a: None)
    try:
        with open(SETTINGS_FILE, encoding="utf-8") as handle:
            original = handle.read()
        settings = json.loads(original) if original.strip() else {}
    except FileNotFoundError:
        original, settings = None, {}
    except (OSError, ValueError) as exc:
        say(f"Could not read {SETTINGS_FILE}, so nothing was changed: {exc}")
        return 1
    if not isinstance(settings, dict) or not isinstance(settings.get("hooks", {}), dict):
        say(f"{SETTINGS_FILE} isn't in the expected shape, so nothing was changed.")
        return 1
    hook = own_command_line("--hook")
    hooks = settings.setdefault("hooks", {})
    added = []
    for event in HOOK_EVENTS:
        groups = hooks.setdefault(event, [])
        commands = [h.get("command", "") for g in groups if isinstance(g, dict) for h in g.get("hooks", []) if isinstance(h, dict)]
        if not any("--hook" in c and ("claude-monitor" in c or "claude-sessions" in c) for c in commands):
            groups.append({"hooks": [{"type": "command", "command": hook, "async": True, "timeout": 10}]})
            added.append(event)
    if "statusLine" not in settings:
        settings["statusLine"] = {"type": "command", "command": own_command_line("--statusline")}
        added.append("statusLine")
    if added:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        if original is not None:
            with open(SETTINGS_FILE + ".claude-sessions-backup", "w", encoding="utf-8") as handle:
                handle.write(original)
        temporary = f"{SETTINGS_FILE}.{os.getpid()}"
        with open(temporary, "w", encoding="utf-8") as handle:
            json.dump(settings, handle, indent=2)
            handle.write("\n")
        os.replace(temporary, SETTINGS_FILE)
        say(f"Added to {SETTINGS_FILE}: {', '.join(added)}. Sessions started from now on use them.")
    else:
        say("Claude Code is already set up for this app.")
    if not WINDOWS and not FROZEN:
        applications = os.path.expanduser("~/.local/share/applications")
        icons = os.path.expanduser("~/.local/share/icons/hicolor/scalable/apps")
        launcher = os.path.join(applications, "claude-sessions.desktop")
        if not os.path.exists(launcher):
            os.makedirs(applications, exist_ok=True)
            os.makedirs(icons, exist_ok=True)
            with open(os.path.join(icons, "claude-sessions.svg"), "w") as handle:
                handle.write(icon_svg())
            with open(launcher, "w") as handle:
                handle.write(
                    "[Desktop Entry]\nType=Application\nName=Claude Sessions\nGenericName=Session Monitor\n"
                    "Comment=Watch and start your Claude Code sessions\n"
                    f"Exec={command_line([SCRIPT_PATH])} --app\nIcon=claude-sessions\nTerminal=false\n"
                    "Categories=Development;\nKeywords=claude;sessions;agents;monitor;\n"
                    f"StartupWMClass={APP_CLASS}\nStartupNotify=true\n"
                )
            say(f"Added Claude Sessions to the applications menu ({launcher}).")
    return 0


def run_statusline():
    """A status line for Claude Code that also saves the figures this app shows. Used when there was none."""
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}
    session_id = str(data.get("session_id", ""))
    if SESSION_ID.match(session_id):
        with contextlib.suppress(OSError, TypeError, ValueError):
            figures = {"context_percent": (data.get("context_window") or {}).get("used_percentage"),
                       "rate_limits": data.get("rate_limits")}
            write_json_file(os.path.join(STATUS_DIR, session_id + ".json"), figures)
    parts = [str((data.get("model") or {}).get("display_name") or "Claude")]
    context = (data.get("context_window") or {}).get("used_percentage")
    if isinstance(context, (int, float)):
        parts.append(f"Ctx {context:.0f}%")
    for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
        used = ((data.get("rate_limits") or {}).get(key) or {}).get("used_percentage")
        if isinstance(used, (int, float)):
            parts.append(f"{label} left {100 - used:.0f}%")
    print(" | ".join(parts))
    return 0


def install_windows():
    """Run from wherever it was downloaded to, the Windows build copies itself into the user's programs
    folder, where it can update itself, adds itself to the Start menu and starts from there.
    Returns True if this copy should stop because the installed one has taken over."""
    if not WINDOWS or not FROZEN or not os.environ.get("LOCALAPPDATA") or os.environ.get("CLAUDE_SESSIONS_NO_INSTALL"):
        return False
    target = os.path.join(WINDOWS_INSTALL_DIR, "claude-sessions.exe")
    if os.path.normcase(os.path.abspath(PROGRAM_PATH)) == os.path.normcase(target):
        return False
    try:
        os.makedirs(WINDOWS_INSTALL_DIR, exist_ok=True)
        temporary = target + ".download"
        shutil.copyfile(PROGRAM_PATH, temporary)
        if os.path.exists(target):
            with contextlib.suppress(OSError):
                os.unlink(target + ".old")
            os.replace(target, target + ".old")  # It may be running.
        os.replace(temporary, target)
    except OSError:
        return False  # Carry on from here instead.
    script = ("$s=(New-Object -ComObject WScript.Shell).CreateShortcut("
              "[Environment]::GetFolderPath('Programs')+'\\Claude Sessions.lnk');"
              "$s.TargetPath=$env:CS_TARGET;$s.Arguments='--app';$s.WorkingDirectory=$env:CS_DIR;"
              "$s.Description='Watch and start your Claude Code sessions';$s.Save()")
    with contextlib.suppress(OSError, subprocess.SubprocessError):
        subprocess.run(["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", script], timeout=30,
                       env={**os.environ, "CS_TARGET": target, "CS_DIR": WINDOWS_INSTALL_DIR}, capture_output=True)
    subprocess.Popen([target, *sys.argv[1:]], close_fds=True)
    return True


def main():
    global wait_for_port
    if sys.stdout is None:  # The Windows build has no console.
        sys.stdout = open(os.devnull, "w")
    if sys.stderr is None:
        sys.stderr = open(os.devnull, "w")
    parser = argparse.ArgumentParser(description="Live monitor for running Claude Code sessions.")
    parser.add_argument("--interval", type=float, default=2.0, help="seconds between refreshes (default 2)")
    parser.add_argument("--once", action="store_true", help="print one snapshot and exit")
    parser.add_argument("--web", action="store_true", help="serve the browser view on this machine only")
    parser.add_argument("--app", action="store_true", help="open the browser view in its own window")
    parser.add_argument("--port", type=int, help=f"port (default {WEB_PORT} for --web, {APP_PORT} for --app)")
    parser.add_argument("--no-open", action="store_true", help="with --web, don't open a browser")
    parser.add_argument("--browser-pid", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--wait-for-port", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--hook", action="store_true", help="handle a Claude Code hook event from stdin")
    parser.add_argument("--statusline", action="store_true", help="status line for Claude Code that also feeds this app")
    parser.add_argument("--setup", action="store_true", help="add this app's hooks (and a status line, if none) to Claude Code")
    parser.add_argument("--session-host", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--version", action="version", version=f"claude-sessions {APP_VERSION}")
    args = parser.parse_args()
    if args.hook:
        return run_hook()
    if args.statusline:
        return run_statusline()
    if args.setup:
        return run_setup()
    if args.session_host:
        return run_session_host()
    wait_for_port = args.wait_for_port
    if WINDOWS:
        with contextlib.suppress(OSError):
            os.unlink(PROGRAM_PATH + ".old")  # Left behind by an update.
        if FROZEN and not (args.web or args.once):
            args.app = True  # There is no terminal view in the Windows build.
        if install_windows():
            return 0
    # Menu launchers don't always inherit the terminal's PATH.
    os.environ["PATH"] += os.pathsep + os.path.expanduser("~/.local/bin")
    if WINDOWS:
        os.environ["PATH"] += os.pathsep + os.path.expanduser(r"~\.local\bin")
    if not shutil.which("claude"):
        if args.app:
            desktop_notify("Claude Sessions can't open", "Claude Code (claude) wasn't found.", True)
            if WINDOWS:
                message_box("Claude Sessions", "Claude Code (claude) wasn't found. Install it, then open this app again.")
        sys.exit("claude-monitor: `claude` was not found on PATH")
    if args.app:
        run_setup(verbose=False)
    monitor = Monitor()
    if args.app:
        return run_app(monitor, args.port or APP_PORT, args.browser_pid)
    if args.web:
        return run_web(monitor, args.port or WEB_PORT, not args.no_open)
    if args.once or not sys.stdout.isatty():
        monitor.refresh()
        print_once(monitor)
        return 1 if monitor.error else 0
    if WINDOWS:
        sys.exit("claude-monitor: the terminal view isn't available on Windows; use --app or --web")
    import curses
    globals()["curses"] = curses
    os.environ.setdefault("ESCDELAY", "25")
    try:
        curses.wrapper(lambda window: Screen(window, monitor, max(0.5, args.interval)).run())
    except KeyboardInterrupt:
        pass
    return 0


def message_box(title, text):
    with contextlib.suppress(Exception):
        ctypes.windll.user32.MessageBoxW(None, text, title, 0x40)


if __name__ == "__main__":
    sys.exit(main())

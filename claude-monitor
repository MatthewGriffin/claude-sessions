def session_name(session_id, cwd):
    chosen = clean(read_names().get(session_id, ""))
    if chosen:
        return chosen
    for path in glob.glob(os.path.join(glob.escape(CONFIG_DIR), "sessions", "[0-9]*.json")):
        try:
            with open(path) as handle:
                record = json.load(handle)
        except (OSError, ValueError):
            continue
        if record.get("sessionId") == session_id and record.get("name"):
            return clean(record["name"])
    return os.path.basename(str(cwd).rstrip("/\\")) or session_id[:8]


def desktop_notify(title, body, urgent, replaces=None):
    """Show a self-expiring notification, returning its id so it can be closed or replaced."""
    if WINDOWS:
        return None  # Not built yet on Windows. The app still shows what needs you.
    command = ["notify-send", "--app-name=Claude Sessions", "--print-id",
               f"--expire-time={URGENT_PING_MS if urgent else PING_MS}"]
    if replaces:
        command.append(f"--replace-id={replaces}")
    # Notification servers treat the body as markup, so transcript text must be escaped.
    command += [html.escape(title), html.escape(body[:300])]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5)
        return int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def close_notification(notification):
    if not notification or WINDOWS:
        return
    try:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
             "--object-path", "/org/freedesktop/Notifications",
             "--method", "org.freedesktop.Notifications.CloseNotification", str(int(notification))],
            capture_output=True, timeout=5,
        )
    except (OSError, ValueError, subprocess.SubprocessError):
        pass


def write_attention(session_id, kind, message, notification):
    os.makedirs(ATTENTION_DIR, exist_ok=True)
    target = os.path.join(ATTENTION_DIR, session_id + ".json")
    temporary = f"{target}.{os.getpid()}"
    with open(temporary, "w") as handle:
        json.dump({"kind": kind, "message": message, "at": time.time(), "notification": notification}, handle)
    os.replace(temporary, target)


# ---- Letting a session see the previews shown beside its chat ----

PREVIEW_WAIT_SECONDS = 15  # A printer camera takes a few seconds to start.


def print_summary(status):
    """The same one-line summary the page shows, for Claude to read."""
    if not status:
        return ""
    minutes = lambda m: f"{int(m) // 60}h {int(m) % 60:02d}m" if m >= 60 else f"{int(m)}m"  # noqa: E731
    bits = []
    if status.get("state") in ("printing", "paused"):
        progress = f" {status['progress']}%" if status.get("progress") is not None else ""
        bits.append(("Paused" if status["state"] == "paused" else "Printing") + progress)
        if status.get("layers"):
            bits.append(f"layer {status.get('layer')} of {status['layers']}")
        if status.get("remaining") is not None:
            bits.append(minutes(status["remaining"]) + " left")
        if status.get("file"):
            bits.append(f"file {status['file']}")
    else:
        bits.append("busy" if status.get("state") == "busy" else "not printing")
    for name in ("nozzle", "bed"):
        if status.get(name) is not None:
            target = f"/{status[name + '_target']}" if status.get(name + "_target") else ""
            bits.append(f"{name} {status[name]}{target}\u00b0C")
    return " \u00b7 ".join(bits)


def session_previews(monitor, query):
    """The previews linked to one session, with a fresh picture of each saved to a file it can open."""
    snapshot = monitor.snapshot()
    session_id, pid = query.get("session", [""])[0], query.get("pid", [""])[0]
    session = next((s for s in snapshot["sessions"] if s["id"] == session_id), None) \
        or next((s for s in snapshot["sessions"] if pid.isdigit() and s["pid"] == int(pid)), None)
    if not session:
        return 404, {"error": "Claude Sessions doesn't know this session. It only sees sessions running on this computer."}
    linked = [d for d in snapshot["devices"] if any(link["id"] == session["id"] for link in d["sessions"])]
    found = []
    for device in linked:
        item = {"serial": device["serial"], "label": device["label"], "kind": device["kind"] or "device",
                "state": device["state"], "print": print_summary(device.get("print"))}
        if query.get("list", [""])[0]:
            found.append(item)
            continue
        printer = device["kind"] == "printer"
        image, deadline = None, time.time() + (PREVIEW_WAIT_SECONDS if printer else 3)
        # A printer's camera is asked directly: just after the app starts, it may still be "checking".
        while printer or device["state"] == "device":
            frame = printer_camera(device["serial"][len("printer-"):]).frame() if printer else monitor.device_frame(device["serial"])
            image = frame[1] if isinstance(frame, tuple) else frame
            if image or time.time() > deadline:
                break
            time.sleep(0.5)
        if image:
            folder = os.path.join(MONITOR_DIR, "previews")
            os.makedirs(folder, exist_ok=True)
            path = os.path.join(folder, f"{session['id'][:8]}-{re.sub(r'[^A-Za-z0-9.-]', '_', device['serial'])}.{image_type(image) or 'png'}")
            with open(path, "wb") as handle:
                handle.write(image)
            item["path"] = path
        else:
            item["problem"] = device.get("problem") or f"no picture right now ({device['state']})"
        if device["kind"] == "printer":  # The camera has just been asked, so its print details are fresh now.
            camera = printer_state["cameras"].get(device["serial"][len("printer-"):])
            item["print"] = print_summary(camera.current_status() if camera else None) or item["print"]
        found.append(item)
    return 200, {"session": session["name"], "devices": found}


def ask_running_app(path, timeout):
    """GET from this user's running Claude Sessions app, as (status, reply), or None if it isn't running."""
    try:
        with open(os.path.join(MONITOR_DIR, "token")) as handle:
            token = handle.read().strip()
    except OSError:
        return None
    for port in [*port_choices(APP_PORT), *port_choices(WEB_PORT)]:
        try:
            connection = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
            connection.request("GET", path, headers={"Cookie": f"monitor_token={token}"})
            response = connection.getresponse()
            body = response.read(1024 * 1024)
            connection.close()
        except (OSError, http.client.HTTPException):
            continue
        if response.getheader("X-Claude-Sessions"):
            with contextlib.suppress(ValueError):
                return response.status, json.loads(body)
    return None


def this_session():
    """(session id, Claude Code's pid) of the session running this command."""
    session_id, pid = os.environ.get("CLAUDE_CODE_SESSION_ID", ""), os.environ.get("CLAUDE_PID", "")
    if not session_id and not pid and not WINDOWS:
        session_id, found = session_ancestor(os.getpid())
        pid = str(found or "")
    return session_id, pid


def run_preview():
    """For Claude: save a current picture of each preview beside this session's chat, and say where."""
    session_id, pid = this_session()
    answer = ask_running_app("/api/previews?" + urllib.parse.urlencode({"session": session_id, "pid": pid}), PREVIEW_WAIT_SECONDS * 3)
    if answer is None:
        print("Claude Sessions isn't running, so there are no previews to see.")
        return 1
    status, reply = answer
    if status != 200:
        print(reply.get("error", "Claude Sessions couldn't find this session."))
        return 1
    if not reply["devices"]:
        print(f"No previews are attached to this session ({reply['session']}) in Claude Sessions right now.")
        return 0
    print(f"Previews beside this session ({reply['session']}) in Claude Sessions:")
    for device in reply["devices"]:
        print(f"- {device['label']} ({device['serial']}, {device['kind']})")
        if device.get("print"):
            print(f"  {device['print']}")
        print(f"  picture: {device['path']}" if device.get("path") else f"  no picture: {device['problem']}")
    if any(d.get("path") for d in reply["devices"]):
        print("Open each picture with the Read tool to see it. Run this again for a newer one.")
    return 0


def run_context_hook():
    """UserPromptSubmit hook: tell Claude, once, which previews are beside its chat and how to look at them."""
    try:
        payload = json.load(sys.stdin)
        session_id = str(payload.get("session_id", ""))
        if not SESSION_ID.match(session_id):
            return 0
        answer = ask_running_app("/api/previews?" + urllib.parse.urlencode({"session": session_id, "list": "1"}), 2)
        if not answer or answer[0] != 200 or not answer[1]["devices"]:
            return 0
        devices = answer[1]["devices"]
        folder = os.path.join(MONITOR_DIR, "announced")
        os.makedirs(folder, exist_ok=True)
        record = os.path.join(folder, session_id + ".json")
        with contextlib.suppress(OSError, ValueError), open(record) as handle:
            if set(json.load(handle)) >= {d["serial"] for d in devices}:
                return 0  # Already told about each of these.
        with open(record, "w") as handle:
            json.dump(sorted(d["serial"] for d in devices), handle)
        names = ", ".join(f"{d['label']} ({d['kind']})" for d in devices)
        context = (f"The Claude Sessions app shows live previews beside this chat: {names}. To see what they show "
                   f"right now, run `{own_command_line('--preview')}`. It saves a current picture of each and prints "
                   "the file paths (and a 3D printer's progress and temperatures); then open the pictures with the Read tool.")
        print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit", "additionalContext": context}}))
    except (OSError, ValueError, TypeError, AttributeError, KeyError):
        pass
    return 0


def run_hook():
    """Handle one Claude Code hook event from stdin. Never fails the session it runs for."""
    try:
        payload = json.load(sys.stdin)
        session_id = str(payload.get("session_id", ""))
        event = payload.get("hook_event_name")
        if not SESSION_ID.match(session_id):
            return 0
        target = os.path.join(ATTENTION_DIR, session_id + ".json")
        try:
            with open(target) as handle:
                previous = json.load(handle)
        except (OSError, ValueError):
            previous = None
        if event in ("UserPromptSubmit", "PostToolUse", "PostToolUseFailure", "SessionEnd"):
            if previous:
                os.unlink(target)
                close_notification(previous.get("notification"))
            return 0
        name = session_name(session_id, payload.get("cwd", ""))
        if event == "PermissionRequest":
            tool = payload.get("tool_name", "a tool")
            is_question = tool == "AskUserQuestion"
            kind, title = ("question", "has a question") if is_question else ("permission", "needs permission")
            message = "Waiting for your answer" if is_question else describe_tool(tool, payload.get("tool_input"))
            ping = not previous or time.time() - previous.get("at", 0) > REPEAT_PING_SECONDS
            urgent = True
        elif event == "Notification":
            if previous:
                return 0  # Already recorded and announced, e.g. by PermissionRequest or Stop.
            kind, title = "input", "needs you"
            message = clean(payload.get("message", "")) or "Waiting for you"
            ping, urgent = True, True
        elif event == "Stop":
            kind, title = "done", "finished"
            message = clean(payload.get("last_assistant_message", "")) or "Ready for your reply"
            ping, urgent = not previous or previous.get("kind") != "done", False
        else:
            return 0
        notification = previous.get("notification") if previous else None
        if ping:
            notification = desktop_notify(f"{name} {title}", message, urgent, notification) or notification
        write_attention(session_id, kind, message, notification)
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return 0


# Phone access: a second listener on the local network, with its own token, so turning it off
# or making a new link locks phones out without touching this computer's own login.
phone = {"server": None, "handler": None, "error": "", "lock": threading.Lock()}


def phone_settings():
    try:
        with open(os.path.join(MONITOR_DIR, "phone.json")) as handle:
            settings = json.load(handle)
        if isinstance(settings.get("token"), str) and len(settings["token"]) >= 32:
            return {"enabled": bool(settings.get("enabled")), "token": settings["token"]}
    except (OSError, ValueError, AttributeError):
        pass
    return {"enabled": False, "token": ""}


def save_phone_settings(settings):
    os.makedirs(MONITOR_DIR, exist_ok=True)
    path = os.path.join(MONITOR_DIR, "phone.json")
    temporary = f"{path}.{os.getpid()}"
    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        json.dump(settings, handle)
    os.replace(temporary, path)


def network_address():
    """This computer's address on the local network: the one its traffic leaves from. Nothing is sent."""
    with contextlib.suppress(OSError), socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as probe:
        probe.connect(("192.0.2.1", 9))  # A documentation address; connecting a UDP socket sends nothing.
        return probe.getsockname()[0]
    return None


def phone_host_ok(host):
    """Only an IP address or this computer's .local name, on the phone port. A site using DNS
    rebinding sends its own domain name, so it's refused."""
    name, _, port = str(host or "").rpartition(":")
    if port != str(PHONE_PORT) or not name:
        return False
    with contextlib.suppress(ValueError):
        ipaddress.ip_address(name.strip("[]"))
        return True
    return name.lower() == socket.gethostname().lower() + ".local"


def set_phone_listening(on):
    """Start or stop the network listener. Returns an error message, or ""."""
    with phone["lock"]:
        if on and not phone["server"] and phone["handler"]:
            try:
                server = WebServer(("0.0.0.0", PHONE_PORT), phone["handler"])
            except OSError as exc:
                phone["error"] = f"Port {PHONE_PORT} is in use, so phones can't connect ({clean(exc)})."
                return phone["error"]
            phone["server"] = server
            threading.Thread(target=server.serve_forever, daemon=True).start()
        elif not on and phone["server"]:
            phone["server"].shutdown()
            phone["server"].server_close()
            phone["server"] = None
        phone["error"] = ""
        return ""


def start_phone_on_launch():
    # After a restart, the copy being replaced can hold the port for a moment.
    for _ in range(30):
        if not set_phone_listening(True) or not phone_settings()["enabled"]:
            return
        time.sleep(0.5)


def phone_state():
    settings = phone_settings()
    address = network_address()
    url = f"http://{address}:{PHONE_PORT}/?t={settings['token']}" if settings["enabled"] and address else ""
    return {"enabled": settings["enabled"], "listening": bool(phone["server"]), "url": url, "error": phone["error"],
            "noNetwork": settings["enabled"] and not address}


def set_phone(monitor, request):
    """Turn phone access on or off, or make a new link, which stops every phone already let in."""
    action = request.get("action")
    settings = phone_settings()
    if action == "on":
        settings = {"enabled": True, "token": settings["token"] or secrets.token_urlsafe(32)}
    elif action == "off":
        settings["enabled"] = False
    elif action == "renew":
        settings["token"] = secrets.token_urlsafe(32)
    else:
        return False, "Unknown action."
    save_phone_settings(settings)
    error = set_phone_listening(settings["enabled"])
    return (False, error) if error else (True, phone_state())


POST_ROUTES["/api/sessions/phone"] = set_phone


def access_token():
    """Token proving a browser was given the link; persisted so bookmarks keep working."""
    os.makedirs(MONITOR_DIR, exist_ok=True)
    path = os.path.join(MONITOR_DIR, "token")
    try:
        with open(path) as handle:
            token = handle.read().strip()
        if token:
            return token
    except FileNotFoundError:
        pass
    token = secrets.token_urlsafe(32)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        handle.write(token)
    return token


def activity_line(session, transcript):
    """What the session is doing now, or failing that what it did last."""
    if session.get("status") == "busy" and transcript.pending:
        return "running  " + list(transcript.pending.values())[-1]
    if transcript.actions:
        return "last     " + transcript.actions[-1]
    return transcript.title or transcript.prompt or "no activity yet"


def quiet_seconds(transcript):
    return time.time() - transcript.mtime if transcript.mtime else None


COLUMNS = [  # title, width, minimum terminal width to show it
    ("SESSION", 24, 0),
    ("STATUS", 8, 0),
    ("PROJECT", 22, 90),
    ("BRANCH", 22, 112),
    ("MODEL", 12, 76),
    ("CTX", 6, 60),
    ("UP", 7, 66),
    ("ACTIVE", 7, 0),
]


def row_values(session, transcript):
    quiet = quiet_seconds(transcript)
    started = session.get("startedAt")
    return [
        session.get("name") or session["sessionId"][:8],
        session.get("status", "?"),
        os.path.basename(session.get("cwd", "").rstrip("/")),
        transcript.branch or "-",
        transcript.model or "-",
        format_tokens(transcript.context),
        format_age(time.time() - started / 1000) if started else "-",
        format_age(quiet) if quiet is not None else "-",
    ]


def format_row(values, width):
    cells = []
    for value, (_, cell_width, min_width) in zip(values, COLUMNS):
        if width >= min_width:
            text = str(value)
            if len(text) > cell_width - 1:
                text = text[: cell_width - 2] + "…"
            cells.append(text.ljust(cell_width))
    return "".join(cells)


def detail_lines(session, transcript):
    lines = [
        ("Title", transcript.title),
        ("Prompt", transcript.prompt),
        ("Said", transcript.text),
        ("Dir", f"{session.get('cwd', '')}   pid {session.get('pid', '?')}   {session.get('kind', '')}"),
    ]
    return [(label, value) for label, value in lines if value]


def print_once(monitor):
    width = shutil.get_terminal_size((120, 24)).columns
    print(monitor.error or monitor.summary())
    print(format_row([c[0] for c in COLUMNS], width))
    for session in monitor.sessions:
        transcript = monitor.transcript(session)
        print(format_row(row_values(session, transcript), width))
        print("  " + activity_line(session, transcript)[: width - 2])


class Screen:
    def __init__(self, window, monitor, interval):
        self.window = window
        self.monitor = monitor
        self.interval = interval
        self.selected = None
        self.colors = {}
        if curses.has_colors():
            curses.use_default_colors()
            for index, (name, color) in enumerate(
                [("busy", curses.COLOR_GREEN), ("warn", curses.COLOR_YELLOW), ("error", curses.COLOR_RED), ("head", curses.COLOR_CYAN)],
                start=1,
            ):
                curses.init_pair(index, color, -1)
                self.colors[name] = curses.color_pair(index)

    def put(self, y, x, text, attr=0):
        height, width = self.window.getmaxyx()
        if 0 <= y < height and x < width:
            try:
                self.window.addnstr(y, x, text, width - x, attr)
            except curses.error:
                pass  # Writing the bottom-right cell raises after drawing it.

    def status_attr(self, status):
        if status == "busy":
            return self.colors.get("busy", 0) | curses.A_BOLD
        if status == "idle":
            return curses.A_DIM
        return self.colors.get("warn", 0) | curses.A_BOLD

    def selected_index(self):
        ids = [s["sessionId"] for s in self.monitor.sessions]
        return ids.index(self.selected) if self.selected in ids else 0

    def move(self, delta):
        sessions = self.monitor.sessions
        if sessions:
            index = min(max(self.selected_index() + delta, 0), len(sessions) - 1)
            self.selected = sessions[index]["sessionId"]

    def draw_session(self, y, session, is_selected, width):
        transcript = self.monitor.transcript(session)
        row = format_row(row_values(session, transcript), width)
        base = curses.A_REVERSE if is_selected else 0
        self.put(y, 0, "> " if is_selected else "  ", base)
        self.put(y, 2, row, base)
        # Status always follows the fixed-width session column.
        status = str(session.get("status", "?"))[:7]
        self.put(y, 2 + COLUMNS[0][1], status, self.status_attr(session.get("status")) | base)
        quiet = quiet_seconds(transcript)
        if session.get("status") == "busy" and quiet is not None and quiet > QUIET_AFTER_SECONDS:
            # Busy with no transcript writes: a long tool run or a pending prompt.
            active_x = 2 + sum(c[1] for c in COLUMNS[:-1] if width >= c[2])
            self.put(y, active_x, format_age(quiet), self.colors.get("warn", 0) | curses.A_BOLD | base)
        self.put(y + 1, 4, activity_line(session, transcript), curses.A_DIM)

    def draw(self):
        self.window.erase()
        height, width = self.window.getmaxyx()
        monitor = self.monitor
        self.put(0, 0, "Claude sessions", self.colors.get("head", 0) | curses.A_BOLD)
        if monitor.error:
            self.put(0, 17, monitor.error, self.colors.get("error", 0) | curses.A_BOLD)
        else:
            self.put(0, 17, monitor.summary())
        clock = time.strftime("%H:%M:%S")
        if width > len(clock) + 40:
            self.put(0, width - len(clock), clock, curses.A_DIM)
        self.put(1, 2, format_row([c[0] for c in COLUMNS], width), curses.A_BOLD)

        sessions = monitor.sessions
        if not sessions:
            self.put(3, 2, "No sessions running.", curses.A_DIM)
            self.put(height - 1, 0, "q quit", curses.A_DIM)
            self.window.refresh()
            return

        index = self.selected_index()
        self.selected = sessions[index]["sessionId"]
        selected_session = sessions[index]
        transcript = monitor.transcript(selected_session)
        details = detail_lines(selected_session, transcript)
        actions = list(transcript.actions)

        # The list gets priority; the detail pane keeps a few lines and takes what remains.
        list_rows = max(1, min(len(sessions), (height - 3 - DETAIL_MIN_LINES) // 2))
        first = min(max(0, index - list_rows + 1), max(0, len(sessions) - list_rows))
        y = 2
        for position in range(first, min(first + list_rows, len(sessions))):
            self.draw_session(y, sessions[position], position == index, width)
            y += 2

        last_row = height - 2
        if y < last_row:
            self.put(y, 0, "─" * width, curses.A_DIM)
            y += 1
            for label, value in details:
                if y > last_row:
                    break
                self.put(y, 2, f"{label + ':':<8}", curses.A_BOLD)
                self.put(y, 10, value)
                y += 1
            for action in reversed(actions):
                if y > last_row:
                    break
                self.put(y, 2, "• " + action, curses.A_DIM)
                y += 1
        hidden = len(sessions) - list_rows
        footer = "up/down select   q quit" + (f"   ({hidden} more, scroll to see)" if hidden > 0 else "")
        self.put(height - 1, 0, footer, curses.A_DIM)
        self.window.refresh()

    def run(self):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        self.window.timeout(200)
        next_refresh = 0
        last_second = None
        while True:
            now = time.time()
            changed = False
            if now >= next_refresh:
                self.monitor.refresh()
                next_refresh = now + self.interval
                changed = True
            key = self.window.getch()
            if key in (ord("q"), ord("Q")):
                return
            if key in (curses.KEY_UP, ord("k")):
                self.move(-1)
            elif key in (curses.KEY_DOWN, ord("j")):
                self.move(1)
            if key != -1 or changed or int(now) != last_second:
                last_second = int(now)
                self.draw()



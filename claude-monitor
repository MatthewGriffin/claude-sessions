<script>
/*PRINT_SUMMARY*/
'use strict';
const SCALE=3, SLOT=34, ROW=46, DOOR=20, STALE=120;
const SHIRTS=['#e0726c','#5aa9e6','#7fc97f','#c78be0','#4fc4b8','#e88fb4','#a3a8f0','#d8c65a'];
const LEAD='#f0a23c', HAIRS=['#3a2a20','#6b4226','#c98f3f','#2b2b3a','#a04a32','#7d7f8c'], SKINS=['#f2c9a0','#d9a273','#a8703f','#f5d6bd'];
const BODY=[
'..HHHHHH..',
'.HHHHHHHH.',
'.HSSSSSSH.',
'.SSESSESS.',
'.SSSSSSSS.',
'..SSSSSS..',
'.CCCCCCCC.',
'SCCCCCCCCS',
'SCCCCCCCCS',
'..CCCCCC..'];
const LEGS=[['..PP..PP..','..PP..PP..','..BB..BB..'],['..PP.PP...','.PP...PP..','.BB....BB.']];
const ICONS={
 term:['#######','#.#...#','#..#..#','#.#.###','#######'],
 doc:['.#####.','.#...#.','.#####.','.#...#.','.#####.'],
 edit:['.....##','....##.','...##..','#.##...','##.....'],
 find:['.###...','#...#..','#...#..','.###.#.','.....##'],
 web:['..###..','.#.#.#.','#######','.#.#.#.','..###..'],
 team:['.#...#.','###.###','.#...#.','#.#.#.#','.......'],
 more:['.......','.......','#.#.#.#','.......','.......'],
 ask:['..###..','.#...#.','....#..','.......','...#...'],
 zzz:['.####..','...#...','..#....','.####..','.......'],
 alert:['...#...','...#...','...#...','.......','...#...']};
function iconFor(desc){
 const t=(desc||'').split(':')[0];
 if(t==='Bash')return'term';
 if(t==='Read')return'doc';
 if(t==='Edit'||t==='Write'||t==='NotebookEdit')return'edit';
 if(t==='Grep'||t==='Glob'||t==='ToolSearch')return'find';
 if(t==='WebFetch'||t==='WebSearch')return'web';
 if(t==='Agent'||t==='Task')return'team';
 return'more';
}
function hash(s){let h=7;for(const c of s)h=(h*31+c.charCodeAt(0))>>>0;return h}
function rect(g,x,y,w,h,c){g.fillStyle=c;g.fillRect(x,y,w,h)}
function grid(g,rows,x,y,map){rows.forEach((r,j)=>{for(let i=0;i<r.length;i++){const c=map[r[i]];if(c){g.fillStyle=c;g.fillRect(x+i,y+j,1,1)}}})}

class Office{
 constructor(canvas){this.canvas=canvas;this.chars=new Map();this.colors=new Map();this.next=0;this.first=true;this.ctx=canvas.getContext('2d')}
 color(id){if(!this.colors.has(id))this.colors.set(id,SHIRTS[this.next++%SHIRTS.length]);return this.colors.get(id)}
 add(id,main,walkIn){
  const used=new Set([...this.chars.values()].filter(c=>c.mode!=='leaving').map(c=>c.slot));
  let slot=main?0:1;while(used.has(slot))slot++;
  const h=hash(id);
  const c={id,main,slot,x:null,mode:walkIn?'entering':'seated',shirt:main?LEAD:this.color(id),hair:HAIRS[h%HAIRS.length],skin:SKINS[(h>>3)%SKINS.length],phase:h%4,mood:'idle',icon:null};
  this.chars.set(id,c);return c;
 }
 sync(s){
  const main=this.chars.get('main')||this.add('main',true,false);
  const waiting=waitsOnTasks(s);
  const busy=s.status==='busy',stale=busy&&!waiting&&s.quiet!==null&&s.quiet>STALE;
  const blocked=s.attention&&s.attention.kind!=='done';
  main.mood=blocked?'alert':waiting?'work':s.status==='idle'?'idle':(!busy||stale)?'ask':'work';
  main.icon=main.mood==='work'?iconFor(s.now||s.actions[0]):null;
  const working=s.subagents.filter(a=>a.state==='working'),seen=new Set(working.map(a=>a.id));
  for(const a of s.subagents)this.color(a.id);
  // Free the desks of departing agents first so new arrivals can take them.
  for(const c of this.chars.values())if(!c.main&&!seen.has(c.id)&&c.mode!=='leaving'){c.mode='leaving';c.mood='work'}
  for(const a of working){
   const c=this.chars.get(a.id)||this.add(a.id,false,!this.first);
   c.mood=a.quiet>STALE?'ask':'work';
   c.icon=iconFor(a.now||a.last);
  }
  this.first=false;
 }
 draw(frame,still){
  const W=Math.max(60,Math.floor(this.canvas.clientWidth/SCALE));
  const cols=Math.max(1,Math.floor((W-DOOR)/SLOT));
  let top=0;for(const c of this.chars.values())if(c.mode!=='leaving')top=Math.max(top,c.slot);
  const rows=Math.floor(top/cols)+1,H=rows*ROW;
  if(this.canvas.width!==W||this.canvas.height!==H){this.canvas.width=W;this.canvas.height=H;this.canvas.style.height=H*SCALE+'px'}
  const g=this.ctx;
  for(let r=0;r<rows;r++){
   const y=r*ROW;
   rect(g,0,y,W,24,'#2c3148');rect(g,0,y+21,W,3,'#22263a');rect(g,0,y+24,W,22,'#3d3a4a');
   for(let x=(r%2)*8;x<W;x+=16)rect(g,x,y+24+(x%3)*7,1,22-(x%3)*7,'#353241');
   rect(g,W-16,y+7,12,17,'#5b4636');rect(g,W-15,y+8,10,16,'#7a5e45');rect(g,W-7,y+16,1,2,'#e8c26a');
  }
  const seated=[],walking=[];
  for(const c of this.chars.values()){
   const row=Math.floor(c.slot/cols),home=6+(c.slot%cols)*SLOT,door=W-14;
   c.row=row;
   if(c.x===null)c.x=c.mode==='entering'?door:home;
   if(c.mode==='seated')c.x=home;
   if(c.mode==='entering'){c.x=still?home:Math.max(home,c.x-4);if(c.x===home)c.mode='seated'}
   if(c.mode==='leaving'){c.x=still?door:Math.min(door,c.x+4);if(c.x>=door){this.chars.delete(c.id);continue}}
   rect(g,home+1,row*ROW+30,24,3,'#8a6a4b');rect(g,home+3,row*ROW+33,2,9,'#6a4f38');rect(g,home+21,row*ROW+33,2,9,'#6a4f38');
   (c.mode==='seated'?seated:walking).push(c);
  }
  for(const c of seated)this.drawSeated(g,c,frame,still);
  for(const c of walking)this.drawWalker(g,c,frame);
 }
 map(c,eye){return{H:c.hair,S:c.skin,E:eye,C:c.shirt,P:'#3b4058',B:'#20222e'}}
 drawSeated(g,c,frame,still){
  const y=c.row*ROW,x=c.x+8,work=c.mood==='work',tick=still?0:frame+c.phase;
  rect(g,x-1,y+22,12,9,'#262938');
  const nod=c.mood==='idle'?1:(work&&c.icon==='doc'&&tick%6<3?1:0);
  const blink=c.mood==='idle'||(!still&&tick%23===0);
  grid(g,BODY,x,y+17+nod,this.map(c,blink?c.skin:'#20222e'));
  if(work){const k=tick%2;rect(g,x-1,y+28+k,2,2,c.skin);rect(g,x+9,y+29-k,2,2,c.skin)}
  rect(g,c.x+9,y+26,9,4,'#3a3f55');rect(g,c.x+10,y+27,7,2,work?'#8fd8ff':'#2a2d3d');rect(g,c.x+8,y+30,11,1,'#5a6078');
  if(c.main){rect(g,x+1,y+13+nod,8,1,'#f4d35e');rect(g,x+1,y+14+nod,1,2,'#f4d35e');rect(g,x+4,y+14+nod,2,2,'#f4d35e');rect(g,x+8,y+14+nod,1,2,'#f4d35e')}
  const icon=c.mood==='idle'?'zzz':c.mood==='ask'?'ask':c.mood==='alert'?'alert':c.icon;
  if(icon&&(icon!=='zzz'||tick%8<6)){
   const bx=x+7,by=y+3;
   rect(g,bx,by,11,8,'#f3f4f8');rect(g,bx+1,by+8,2,1,'#f3f4f8');
   grid(g,ICONS[icon],bx+2,by+1,{'#':c.mood==='alert'?'#d6452f':c.mood==='ask'?'#c9851a':'#2a2d3d'});
  }
 }
 drawWalker(g,c,frame){
  const y=c.row*ROW+28,x=Math.round(c.x),m=this.map(c,'#20222e');
  grid(g,BODY,x,y,m);grid(g,LEGS[frame%2],x,y+10,m);
 }
}

function el(tag,cls,parent,text){const e=document.createElement(tag);if(cls)e.className=cls;if(text!==undefined)e.textContent=text;if(parent)parent.appendChild(e);return e}
function age(sec){if(sec===null||sec===undefined)return'-';if(sec<60)return sec+'s';if(sec<3600)return Math.floor(sec/60)+'m';return Math.floor(sec/3600)+'h'+String(Math.floor(sec%3600/60)).padStart(2,'0')+'m'}

const LABELS={permission:'Needs permission',question:'Has a question',input:'Needs you',done:'Finished'};
const $=id=>document.getElementById(id);
const cards=new Map(),gridEl=$('grid');
function contextText(s){
 if(s.context==='-'&&s.contextPercent===null)return'';
 return'ctx '+(s.context==='-'?'':s.context+' ')+(s.contextPercent===null?'':'('+Math.round(s.contextPercent)+'%)');
}
function clockText(at){return new Date(at*1000).toLocaleTimeString([],{hour:'numeric',minute:'2-digit'})}
function untilText(at){
 const sec=at-Date.now()/1000;
 if(sec<3600)return Math.ceil(sec/60)+'m';
 if(sec<86400)return Math.floor(sec/3600)+'h'+Math.floor(sec%3600/60)+'m';
 return Math.floor(sec/86400)+'d'+Math.floor(sec%86400/3600)+'h';
}
function usageWindow(box,label,w,at){
 if(!w)return;
 const row=el('span','',box),past=w.resets&&w.resets*1000<Date.now();
 // Past its reset time, the saved figure is about a window that has ended.
 if(past){row.append(label+' left ');el('b','',row,'reset');row.title='Its reset time has passed. It updates on the next Claude activity.';return}
 const left=Math.max(0,Math.round(100-w.used));
 row.className=left<=10?'out':left<=25?'low':'';
 row.append(label+' left ');el('b','',row,left+'%');
 if(w.resets)row.append(' ('+untilText(w.resets)+')');
 row.title=Math.round(w.used)+'% used';
}
function ageText(at){return age(Math.max(0,Math.round(Date.now()/1000-at)))+' ago'}
async function resumeSession(id,trust){
 const r=await fetch('/api/sessions/resume',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id,trust})});
 const d=await r.json().catch(()=>({error:'Unexpected response (HTTP '+r.status+').'}));
 if(d.needsTrust&&!trust&&confirm('Trust this folder? Claude Code will be able to read, edit and run files in '+d.cwd))return resumeSession(id,d.cwd);
 return r.ok?'':d.error||'Could not resume that session.';
}
async function runPrevious(work){
 for(const b of $('previous').querySelectorAll('button'))b.disabled=true;
 $('prevErr').textContent='';
 try{$('prevErr').textContent=await work()||''}
 catch(e){$('prevErr').textContent='Lost connection to claude-monitor.'}
 finally{prevKey=null;await refresh()}
}
let prevKey=null;
function renderPrevious(list,remember){
 const key=JSON.stringify([list,remember]);
 if(key===prevKey)return;  // Rebuilding on every poll would lose a click in progress.
 prevKey=key;
 $('prevRemember').checked=remember;
 $('prevTitle').textContent='Previous sessions'+(list.length?' ('+list.length+')':'');
 $('prevAll').hidden=list.length<2;$('prevAll').disabled=false;
 const rows=list.map(p=>{
  const row=el('div','prev'),text=el('div','prevtext',row);
  el('b','',text,p.name||p.id.slice(0,8));
  el('small','',text,p.cwd+' · last seen '+ageText(p.seen));
  if(p.title)el('small','',text,p.title);
  const go=el('button','primary',row,'Resume');go.type='button';
  go.addEventListener('click',()=>runPrevious(()=>resumeSession(p.id)));
  const forget=el('button','',row,'Forget');forget.type='button';
  forget.addEventListener('click',()=>runPrevious(async()=>(await post('forget',{id:p.id})).error));
  return row;
 });
 $('prevList').replaceChildren(...rows);
 $('prevAll').onclick=()=>{
  if(confirm('Resume all '+list.length+' sessions? They stay idle until you message them.'))runPrevious(async()=>{
   const problems=[];
   for(const p of list){const e=await resumeSession(p.id);if(e)problems.push((p.name||p.id.slice(0,8))+': '+e)}
   return problems.join(' ');
  });
 };
}
$('prevRemember').addEventListener('change',e=>{
 const on=e.target.checked;
 if(!on&&!confirm('Stop remembering sessions and clear this list?')){e.target.checked=true;return}
 runPrevious(async()=>(await post('remember',{on})).error);
});
function renderUsage(u){
 for(const box of [$('usage'),$('histUsage')]){
  box.replaceChildren();
  if(!u)continue;
  usageWindow(box,'5h',u.five,u.at);usageWindow(box,'7d',u.seven,u.at);
  const old=Date.now()/1000-u.at;
  // Claude Code only reports usage while a session is active.
  if(old>600)el('span','',box,'as of '+age(Math.round(old))+' ago');
 }
}
function makeCard(s){
 const root=el('article','card'),head=el('div','head',root),top=el('div','top',head);
 const c={root,name:el('span','name',top),pill:el('span','pill',top),meta:el('div','meta',head),title:el('div','title',head)};
 c.hbtn=el('button','hbtn',top,'History');c.hbtn.addEventListener('click',()=>openHistory(c.session));
 c.need=el('div','need',root);
 c.fail=el('div','need failed',root);c.fail.hidden=true;
 root.addEventListener('click',e=>{if(!e.target.closest('details,button')&&!String(getSelection()))openHistory(c.session)});
 c.canvas=el('canvas','',root);c.canvas.setAttribute('role','img');
 c.office=new Office(c.canvas);
 c.now=el('div','now',root);c.subs=el('div','subs',root);
 c.devs=el('div','devs',root);c.devs.hidden=true;
 const d=el('details','',root);el('summary','',d,'prompt, last message and recent actions');
 el('h3','',d,'Last prompt');c.prompt=el('p','',d);
 el('h3','',d,'Last message');c.said=el('p','',d);
 el('h3','',d,'Recent actions');c.actions=el('ul','',d);
 el('h3','',d,'Where');c.where=el('p','',d);
 return c;
}
function update(c,s){
 const bg=s.background||[],waiting=waitsOnTasks(s);
 const cls=s.status==='busy'||waiting?'busy':s.status==='idle'?'idle':'other';
 c.session=s;
 c.hbtn.textContent=s.hosted?'Reply':'History';
 if(histSession===s.id)updateFoot(s);
 const needs=s.attention&&s.attention.kind!=='done';
 c.root.className='card '+cls+(needs?' needs':'');
 c.need.hidden=!s.attention;
 if(s.attention){
  c.need.className='need'+(needs?'':' done');
  c.need.textContent=(LABELS[s.attention.kind]||'Needs you')+': '+s.attention.message;
 }
 c.fail.hidden=!s.failure;
 if(s.failure)c.fail.textContent='Message failed: '+s.failure.message+(s.retryAt?' · retrying at '+clockText(s.retryAt):'');

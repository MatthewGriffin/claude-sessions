def app_browser():
    """Command and profile folder for a Chromium-family browser, or None if there isn't one."""
    if WINDOWS:
        roots = [os.environ.get(v) for v in ("PROGRAMFILES(X86)", "PROGRAMFILES", "LOCALAPPDATA")]
        for relative in (r"Microsoft\Edge\Application\msedge.exe", r"Google\Chrome\Application\chrome.exe",
                         r"BraveSoftware\Brave-Browser\Application\brave.exe", r"Chromium\Application\chrome.exe"):
            for root in filter(None, roots):
                if os.path.isfile(os.path.join(root, relative)):
                    return [os.path.join(root, relative)], os.path.join(MONITOR_DIR, "app-profile")
        found = shutil.which("msedge") or shutil.which("chrome")
        return ([found], os.path.join(MONITOR_DIR, "app-profile")) if found else None
    for name in ("chromium-browser", "chromium", "google-chrome-stable", "google-chrome", "brave-browser"):
        if shutil.which(name):
            return [name], os.path.join(MONITOR_DIR, "app-profile")
    flatpak = "org.chromium.Chromium"
    if shutil.which("flatpak") and subprocess.run(["flatpak", "info", flatpak], capture_output=True).returncode == 0:
        # A sandboxed browser can only write inside its own data folder.
        return ["flatpak", "run", flatpak], os.path.expanduser(f"~/.var/app/{flatpak}/data/claude-sessions-profile")
    return None


def start_app_window(browser, url):
    command, profile = browser
    return subprocess.Popen(command + [
        f"--app={url}", f"--user-data-dir={profile}", f"--class={APP_CLASS}",
        "--no-first-run", "--no-default-browser-check", "--password-store=basic",
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def open_app_window(browser, url):
    """Open the app window and block until it closes. Returns the browser's exit code."""
    return start_app_window(browser, url).wait()


def wait_for_window():
    """Block until the app window closes. After a restart it's still this process's child, by id."""
    if WINDOWS:
        # After a restart the window isn't this process's child, so wait on it by its id.
        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
        kernel32.OpenProcess.restype = wintypes.HANDLE
        kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
        kernel32.WaitForSingleObject.argtypes = [wintypes.HANDLE, wintypes.DWORD]
        kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
        handle = kernel32.OpenProcess(0x00100000, False, attached_browser_pid)  # SYNCHRONIZE
        if not handle:
            return 0
        try:
            kernel32.WaitForSingleObject(handle, 0xFFFFFFFF)
        finally:
            kernel32.CloseHandle(handle)
        return 0
    try:
        return os.waitstatus_to_exitcode(os.waitpid(attached_browser_pid, 0)[1])
    except (OSError, ValueError):
        return 0


page_seen = {"at": 0.0}  # When the app's page last asked for the session list.
WINDOW_HANDOVER_SECONDS = 30  # For a window handed to a browser that was already running to first call.
WINDOW_IDLE_SECONDS = 150  # Longer than a minimised window's slowed-down timers.


def wait_while_page_open(handover=None, idle=None):
    """Keep serving after the browser process ends, for as long as the page still calls.

    If a browser using the app's profile is still running (it can take a while to close after the
    window does, and Edge often stays), the newly started one hands the window over to it and exits
    at once. Stopping then left a window that couldn't connect.
    """
    handover = WINDOW_HANDOVER_SECONDS if handover is None else handover
    idle = WINDOW_IDLE_SECONDS if idle is None else idle
    ended = time.monotonic()
    while True:
        seen = page_seen["at"]
        if seen > ended:
            if time.monotonic() - seen > idle:
                return
        elif time.monotonic() - ended > handover and time.monotonic() - seen > idle:
            return
        time.sleep(1)


def run_app(monitor, port, browser_pid=None, fixed_port=False):
    browser = app_browser()
    if not browser:
        desktop_notify("Claude Sessions can't open", "It needs Chromium, Chrome or Brave installed.", True)
        if WINDOWS:
            message_box("Claude Sessions", "It needs Microsoft Edge, Chrome or Brave installed.")
        return 1
    return run_web(monitor, port, False, browser, browser_pid, fixed_port)


class WebServer(http.server.ThreadingHTTPServer):
    allow_reuse_address = not WINDOWS  # On Windows it would let a second copy share the port.


wait_for_port = False  # Set on a restart, while the copy being replaced lets go of the port.


def bind_server(port, handler):
    deadline = time.time() + (15 if wait_for_port else 0)
    while True:
        try:
            return WebServer(("127.0.0.1", port), handler)
        except OSError:
            if time.time() >= deadline:
                raise
            time.sleep(0.2)


def app_answers(port):
    """Whether this app's own server is on the port, rather than some other program."""
    try:
        connection = http.client.HTTPConnection("127.0.0.1", port, timeout=2)
        connection.request("GET", "/api/sessions")
        response = connection.getresponse()
        body = response.read(200)
        connection.close()
    except (OSError, http.client.HTTPException):
        return False
    # Versions up to 0.1.6 had no header, but turned the request away with this text.
    return bool(response.getheader("X-Claude-Sessions")) or body.startswith(b"Open the link printed by: claude-monitor")


serving_port = None  # The port this copy's server got, which a restart keeps.


def run_web(monitor, port, open_browser, app_browser_command=None, browser_pid=None, fixed_port=True):
    global attached_browser_pid, serving_port
    token = access_token()
    # Process arguments are visible to other users, so the app window gets a single-use code.
    app_codes = {secrets.token_urlsafe(32)} if app_browser_command else set()

    class Handler(http.server.BaseHTTPRequestHandler):
        on_phone = False  # The copy listening on the local network, for phones.

        def host_ok(self):
            # Rejecting other Host values stops a malicious site reading this via DNS rebinding.
            if self.on_phone:
                return phone_host_ok(self.headers.get("Host"))
            return self.headers.get("Host") in allowed_hosts

        def login_token(self):
            if not self.on_phone:
                return token
            settings = phone_settings()
            return settings["token"] if settings["enabled"] else ""

        def respond(self, status, content_type, body, extra_headers=()):
            self.send_response(status)
            for header, value in extra_headers:
                self.send_header(header, value)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("X-Claude-Sessions", "1")  # So a second copy knows this port is ours.
            self.send_header(
                "Content-Security-Policy",
                "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; connect-src 'self'; img-src data: 'self'; "
                "form-action 'none'; base-uri 'none'; frame-ancestors 'none'",
            )
            self.end_headers()
            self.wfile.write(body)

        def authorized(self):
            cookie = http.cookies.SimpleCookie(self.headers.get("Cookie", ""))
            name = "monitor_phone" if self.on_phone else "monitor_token"
            sent = cookie[name].value if name in cookie else ""
            expected = self.login_token()
            return bool(expected) and hmac.compare_digest(sent.encode(), expected.encode())

        def send_json(self, status, value):
            self.respond(status, "application/json", json.dumps(value).encode())

        def do_GET(self):
            if not self.host_ok():
                self.respond(403, "text/plain", b"forbidden")
                return
            parts = urllib.parse.urlsplit(self.path)
            query = urllib.parse.parse_qs(parts.query)
            sent = query.get("t", [""])[0]
            expected = self.login_token()
            if sent in app_codes and not self.on_phone:
                app_codes.discard(sent)
                valid = True
            else:
                valid = bool(sent) and bool(expected) and hmac.compare_digest(sent.encode(), expected.encode())
            if parts.path == "/" and valid:
                # Move the token out of the address bar into a cookie other sites can't send.
                name = "monitor_phone" if self.on_phone else "monitor_token"
                # A phone opens the link from its camera app, which browsers count as another site, and a
                # Strict cookie wouldn't come back on the redirect below. Lax does, and still isn't sent
                # with another site's POSTs, which also need a matching Origin.
                same_site = "Lax" if self.on_phone else "Strict"
                cookie = f"{name}={expected}; HttpOnly; SameSite={same_site}; Path=/" + ("; Max-Age=31536000" if self.on_phone else "")
                self.respond(302, "text/plain", b"", [("Location", "/"), ("Set-Cookie", cookie)])
            elif not self.authorized():
                message = b"Scan the phone code in Claude Sessions on your computer again.\n" if self.on_phone else b"Open the link printed by: claude-monitor --web\n"
                self.respond(403, "text/plain; charset=utf-8", message)
            elif parts.path == "/api/phone":
                if self.on_phone:
                    self.respond(403, "text/plain", b"forbidden")
                else:
                    self.send_json(200, phone_state())
            elif parts.path == "/":
                self.respond(200, "text/html; charset=utf-8", PAGE.encode())
            elif parts.path == "/api/sessions":
                if not self.on_phone:
                    page_seen["at"] = time.monotonic()
                self.send_json(200, monitor.snapshot())
            elif parts.path == "/api/printers":
                self.send_json(200, printers_view())
            elif parts.path == "/api/previews" and not self.on_phone:
                status, reply = session_previews(monitor, query)
                self.send_json(status, reply)
            elif parts.path == "/api/commands":
                commands = monitor.commands(query.get("id", [""])[0])
                if commands is None:
                    self.send_json(404, {"error": "That session is no longer running."})
                else:
                    self.send_json(200, {"commands": commands})
            elif parts.path == "/api/folders":
                self.send_json(200, {"folders": trusted_folders()})
            elif parts.path == "/api/device/screen":
                frame = monitor.device_frame(query.get("serial", [""])[0])
                try:
                    if frame:
                        self.respond(200, frame[0], frame[1])
                    else:
                        self.respond(404, "text/plain", b"no picture available")
                except (BrokenPipeError, ConnectionResetError):
                    pass  # The page moved on to a newer frame.
            elif parts.path == "/api/history":
                try:
                    limit = max(1, min(int(query.get("limit", [""])[0]), 100000))
                except ValueError:
                    limit = HISTORY_LIMIT
                history = monitor.history(query.get("id", [""])[0], limit, query.get("since", [None])[0])
                if history is None:
                    self.send_json(404, {"error": "That session is no longer running."})
                else:
                    self.send_json(200, history)
            elif parts.path == "/api/upload":
                name = query.get("name", [""])[0]
                path = upload_path(name)
                if not path:
                    self.respond(404, "text/plain", b"not found")
                else:
                    with open(path, "rb") as handle:
                        self.respond(200, UPLOAD_TYPES[name.rsplit(".", 1)[1]], handle.read())
            elif parts.path == "/api/tool":
                details = monitor.tool_details(query.get("id", [""])[0], query.get("tool", [""])[0], query.get("agent", [None])[0])
                if details is None:
                    self.send_json(404, {"error": "That is no longer available."})
                else:
                    self.send_json(200, details)
            elif parts.path == "/api/subagents":
                open_ids = set(query.get("open", [""])[0].split(","))
                agents = monitor.subagents(query.get("id", [""])[0], open_ids, query.get("since", [None])[0])
                if agents is None:
                    self.send_json(404, {"error": "That session is no longer running."})
                else:
                    self.send_json(200, agents)
            elif parts.path == "/api/screen":
                session_id = query.get("id", [""])[0]
                session = next((s for s in monitor.snapshot()["sessions"] if s["id"] == session_id), None)
                if session and session["hosted"]:
                    screen = session_screen(session["tmux"])
                    self.send_json(200, {"screen": screen, "live": live_activity(screen), "options": menu_options(screen)})
                else:
                    self.send_json(404, {"error": "Not available for this session."})
            else:
                self.respond(404, "text/plain", b"not found")

        def do_POST(self):
            # Starts a program, so also require a same-origin JSON request from a tokened browser.
            if self.on_phone:
                origin_ok = self.headers.get("Origin") == "http://" + str(self.headers.get("Host"))
            else:
                origin_ok = self.headers.get("Origin") in allowed_origins
            is_json = self.headers.get("Content-Type", "").split(";")[0].strip() == "application/json"
            if not self.host_ok() or not origin_ok or not is_json or not self.authorized():
                self.respond(403, "text/plain", b"forbidden")
                return
            action = POST_ROUTES.get(self.path)
            if self.on_phone and action is set_phone:
                self.respond(403, "text/plain", b"forbidden")  # Only this computer turns phone access on or off.
                return
            if not action:
                self.respond(404, "text/plain", b"not found")
                return
            try:
                length = int(self.headers.get("Content-Length", 0))
                if not 0 < length <= (UPLOAD_REQUEST_BYTES if action is save_upload else 65536):
                    raise ValueError
                request = json.loads(self.rfile.read(length))
                if not isinstance(request, dict):
                    raise ValueError
            except ValueError:
                self.send_json(400, {"error": "Invalid request."})
                return
            succeeded, message = action(monitor, request)
            monitor.invalidate()
            failure = message if isinstance(message, dict) else {"error": message}
            self.send_json(200 if succeeded else 400, {"message": message} if succeeded else failure)

        def log_message(self, *args):
            pass

    server = running = failure = None
    for port in [port] if fixed_port else port_choices(port):
        try:
            server = bind_server(port, Handler)
            break
        except OSError as exc:
            failure = exc
            if app_answers(port):
                running = port
                break
            # Another program has this port, or Windows keeps it back, so try the next.
    allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    allowed_origins = {f"http://{host}" for host in allowed_hosts}
    url = f"http://127.0.0.1:{port}/?t={token}"
    app_url = f"http://127.0.0.1:{port}/?t={next(iter(app_codes))}" if app_codes else ""
    if running and app_browser_command:
        # Already open: this browser profile holds the cookie, so no code is needed.
        return open_app_window(app_browser_command, f"http://127.0.0.1:{running}/")
    if running:
        sys.exit(f"claude-monitor is already running. Open: {url}")
    if not server:
        if app_browser_command and WINDOWS:
            message_box("Claude Sessions", f"Claude Sessions couldn't start, because other programs are using its ports ({failure}).")
        sys.exit(f"claude-monitor: cannot use port {port} ({failure}); try --port N")
    serving_port = port
    threading.Thread(target=releases.watch, daemon=True).start()
    threading.Thread(target=run_queue_delivery, args=(monitor,), daemon=True).start()
    threading.Thread(target=installed_commands, daemon=True).start()  # Reading Claude Code takes a few seconds.
    phone["handler"] = type("PhoneHandler", (Handler,), {"on_phone": True})
    if phone_settings()["enabled"]:
        threading.Thread(target=start_phone_on_launch, daemon=True).start()
    if app_browser_command:
        threading.Thread(target=server.serve_forever, daemon=True).start()
        attached_browser_pid = browser_pid or start_app_window(app_browser_command, app_url).pid
        code = wait_for_window()
        wait_while_page_open()
        server.shutdown()
        return code
    print(f"Claude sessions monitor: {url}   (Ctrl+C to stop)", flush=True)
    if open_browser:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0



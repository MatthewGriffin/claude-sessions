'..HHHHHH..',
'.HHHHHHHH.',
'.HSSSSSSH.',
'.SSESSESS.',
'.SSSSSSSS.',
'..SSSSSS..',
'.CCCCCCCC.',
'SCCCCCCCCS',
'SCCCCCCCCS',
'..CCCCCC..'];

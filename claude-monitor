def session_name(session_id, cwd):
    chosen = clean(read_names().get(session_id, ""))
    if chosen:
        return chosen
    for path in glob.glob(os.path.join(glob.escape(CONFIG_DIR), "sessions", "[0-9]*.json")):
        try:
            with open(path) as handle:
                record = json.load(handle)
        except (OSError, ValueError):
            continue
        if record.get("sessionId") == session_id and record.get("name"):
            return clean(record["name"])
    return os.path.basename(str(cwd).rstrip("/\\")) or session_id[:8]


def desktop_notify(title, body, urgent, replaces=None):
    """Show a self-expiring notification, returning its id so it can be closed or replaced."""
    if WINDOWS:
        return None  # Not built yet on Windows. The app still shows what needs you.
    command = ["notify-send", "--app-name=Claude Sessions", "--print-id",
               f"--expire-time={URGENT_PING_MS if urgent else PING_MS}"]
    if replaces:
        command.append(f"--replace-id={replaces}")
    # Notification servers treat the body as markup, so transcript text must be escaped.
    command += [html.escape(title), html.escape(body[:300])]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=5)
        return int(result.stdout.strip())
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def close_notification(notification):
    if not notification or WINDOWS:
        return
    try:
        subprocess.run(
            ["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
             "--object-path", "/org/freedesktop/Notifications",
             "--method", "org.freedesktop.Notifications.CloseNotification", str(int(notification))],
            capture_output=True, timeout=5,
        )
    except (OSError, ValueError, subprocess.SubprocessError):
        pass


def write_attention(session_id, kind, message, notification):
    os.makedirs(ATTENTION_DIR, exist_ok=True)
    target = os.path.join(ATTENTION_DIR, session_id + ".json")
    temporary = f"{target}.{os.getpid()}"
    with open(temporary, "w") as handle:
        json.dump({"kind": kind, "message": message, "at": time.time(), "notification": notification}, handle)
    os.replace(temporary, target)


def run_hook():
    """Handle one Claude Code hook event from stdin. Never fails the session it runs for."""
    try:
        payload = json.load(sys.stdin)
        session_id = str(payload.get("session_id", ""))
        event = payload.get("hook_event_name")
        if not SESSION_ID.match(session_id):
            return 0
        target = os.path.join(ATTENTION_DIR, session_id + ".json")
        try:
            with open(target) as handle:
                previous = json.load(handle)
        except (OSError, ValueError):
            previous = None
        if event in ("UserPromptSubmit", "PostToolUse", "PostToolUseFailure", "SessionEnd"):
            if previous:
                os.unlink(target)
                close_notification(previous.get("notification"))
            return 0
        name = session_name(session_id, payload.get("cwd", ""))
        if event == "PermissionRequest":
            tool = payload.get("tool_name", "a tool")
            is_question = tool == "AskUserQuestion"
            kind, title = ("question", "has a question") if is_question else ("permission", "needs permission")
            message = "Waiting for your answer" if is_question else describe_tool(tool, payload.get("tool_input"))
            ping = not previous or time.time() - previous.get("at", 0) > REPEAT_PING_SECONDS
            urgent = True
        elif event == "Notification":
            if previous:
                return 0  # Already recorded and announced, e.g. by PermissionRequest or Stop.
            kind, title = "input", "needs you"
            message = clean(payload.get("message", "")) or "Waiting for you"
            ping, urgent = True, True
        elif event == "Stop":
            kind, title = "done", "finished"
            message = clean(payload.get("last_assistant_message", "")) or "Ready for your reply"
            ping, urgent = not previous or previous.get("kind") != "done", False
        else:
            return 0
        notification = previous.get("notification") if previous else None
        if ping:
            notification = desktop_notify(f"{name} {title}", message, urgent, notification) or notification
        write_attention(session_id, kind, message, notification)
    except (OSError, ValueError, TypeError, AttributeError):
        pass
    return 0


def access_token():
    """Token proving a browser was given the link; persisted so bookmarks keep working."""
    os.makedirs(MONITOR_DIR, exist_ok=True)
    path = os.path.join(MONITOR_DIR, "token")
    try:
        with open(path) as handle:
            token = handle.read().strip()
        if token:
            return token
    except FileNotFoundError:
        pass
    token = secrets.token_urlsafe(32)
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        handle.write(token)
    return token


def activity_line(session, transcript):
    """What the session is doing now, or failing that what it did last."""
    if session.get("status") == "busy" and transcript.pending:
        return "running  " + list(transcript.pending.values())[-1]
    if transcript.actions:
        return "last     " + transcript.actions[-1]
    return transcript.title or transcript.prompt or "no activity yet"


def quiet_seconds(transcript):
    return time.time() - transcript.mtime if transcript.mtime else None


COLUMNS = [  # title, width, minimum terminal width to show it
    ("SESSION", 24, 0),
    ("STATUS", 8, 0),
    ("PROJECT", 22, 90),
    ("BRANCH", 22, 112),
    ("MODEL", 12, 76),
    ("CTX", 6, 60),
    ("UP", 7, 66),
    ("ACTIVE", 7, 0),
]


def row_values(session, transcript):
    quiet = quiet_seconds(transcript)
    started = session.get("startedAt")
    return [
        session.get("name") or session["sessionId"][:8],
        session.get("status", "?"),
        os.path.basename(session.get("cwd", "").rstrip("/")),
        transcript.branch or "-",
        transcript.model or "-",
        format_tokens(transcript.context),
        format_age(time.time() - started / 1000) if started else "-",
        format_age(quiet) if quiet is not None else "-",
    ]


def format_row(values, width):
    cells = []
    for value, (_, cell_width, min_width) in zip(values, COLUMNS):
        if width >= min_width:
            text = str(value)
            if len(text) > cell_width - 1:
                text = text[: cell_width - 2] + "…"
            cells.append(text.ljust(cell_width))
    return "".join(cells)


def detail_lines(session, transcript):
    lines = [
        ("Title", transcript.title),
        ("Prompt", transcript.prompt),
        ("Said", transcript.text),
        ("Dir", f"{session.get('cwd', '')}   pid {session.get('pid', '?')}   {session.get('kind', '')}"),
    ]
    return [(label, value) for label, value in lines if value]


def print_once(monitor):
    width = shutil.get_terminal_size((120, 24)).columns
    print(monitor.error or monitor.summary())
    print(format_row([c[0] for c in COLUMNS], width))
    for session in monitor.sessions:
        transcript = monitor.transcript(session)
        print(format_row(row_values(session, transcript), width))
        print("  " + activity_line(session, transcript)[: width - 2])


class Screen:
    def __init__(self, window, monitor, interval):
        self.window = window
        self.monitor = monitor
        self.interval = interval
        self.selected = None
        self.colors = {}
        if curses.has_colors():
            curses.use_default_colors()
            for index, (name, color) in enumerate(
                [("busy", curses.COLOR_GREEN), ("warn", curses.COLOR_YELLOW), ("error", curses.COLOR_RED), ("head", curses.COLOR_CYAN)],
                start=1,
            ):
                curses.init_pair(index, color, -1)
                self.colors[name] = curses.color_pair(index)

    def put(self, y, x, text, attr=0):
        height, width = self.window.getmaxyx()
        if 0 <= y < height and x < width:
            try:
                self.window.addnstr(y, x, text, width - x, attr)
            except curses.error:
                pass  # Writing the bottom-right cell raises after drawing it.

    def status_attr(self, status):
        if status == "busy":
            return self.colors.get("busy", 0) | curses.A_BOLD
        if status == "idle":
            return curses.A_DIM
        return self.colors.get("warn", 0) | curses.A_BOLD

    def selected_index(self):
        ids = [s["sessionId"] for s in self.monitor.sessions]
        return ids.index(self.selected) if self.selected in ids else 0

    def move(self, delta):
        sessions = self.monitor.sessions
        if sessions:
            index = min(max(self.selected_index() + delta, 0), len(sessions) - 1)
            self.selected = sessions[index]["sessionId"]

    def draw_session(self, y, session, is_selected, width):
        transcript = self.monitor.transcript(session)
        row = format_row(row_values(session, transcript), width)
        base = curses.A_REVERSE if is_selected else 0
        self.put(y, 0, "> " if is_selected else "  ", base)
        self.put(y, 2, row, base)
        # Status always follows the fixed-width session column.
        status = str(session.get("status", "?"))[:7]
        self.put(y, 2 + COLUMNS[0][1], status, self.status_attr(session.get("status")) | base)
        quiet = quiet_seconds(transcript)
        if session.get("status") == "busy" and quiet is not None and quiet > QUIET_AFTER_SECONDS:
            # Busy with no transcript writes: a long tool run or a pending prompt.
            active_x = 2 + sum(c[1] for c in COLUMNS[:-1] if width >= c[2])
            self.put(y, active_x, format_age(quiet), self.colors.get("warn", 0) | curses.A_BOLD | base)
        self.put(y + 1, 4, activity_line(session, transcript), curses.A_DIM)

    def draw(self):
        self.window.erase()
        height, width = self.window.getmaxyx()
        monitor = self.monitor
        self.put(0, 0, "Claude sessions", self.colors.get("head", 0) | curses.A_BOLD)
        if monitor.error:
            self.put(0, 17, monitor.error, self.colors.get("error", 0) | curses.A_BOLD)
        else:
            self.put(0, 17, monitor.summary())
        clock = time.strftime("%H:%M:%S")
        if width > len(clock) + 40:
            self.put(0, width - len(clock), clock, curses.A_DIM)
        self.put(1, 2, format_row([c[0] for c in COLUMNS], width), curses.A_BOLD)

        sessions = monitor.sessions
        if not sessions:
            self.put(3, 2, "No sessions running.", curses.A_DIM)
            self.put(height - 1, 0, "q quit", curses.A_DIM)
            self.window.refresh()
            return

        index = self.selected_index()
        self.selected = sessions[index]["sessionId"]
        selected_session = sessions[index]
        transcript = monitor.transcript(selected_session)
        details = detail_lines(selected_session, transcript)
        actions = list(transcript.actions)

        # The list gets priority; the detail pane keeps a few lines and takes what remains.
        list_rows = max(1, min(len(sessions), (height - 3 - DETAIL_MIN_LINES) // 2))
        first = min(max(0, index - list_rows + 1), max(0, len(sessions) - list_rows))
        y = 2
        for position in range(first, min(first + list_rows, len(sessions))):
            self.draw_session(y, sessions[position], position == index, width)
            y += 2

        last_row = height - 2
        if y < last_row:
            self.put(y, 0, "─" * width, curses.A_DIM)
            y += 1
            for label, value in details:
                if y > last_row:
                    break
                self.put(y, 2, f"{label + ':':<8}", curses.A_BOLD)
                self.put(y, 10, value)
                y += 1
            for action in reversed(actions):
                if y > last_row:
                    break
                self.put(y, 2, "• " + action, curses.A_DIM)
                y += 1
        hidden = len(sessions) - list_rows
        footer = "up/down select   q quit" + (f"   ({hidden} more, scroll to see)" if hidden > 0 else "")
        self.put(height - 1, 0, footer, curses.A_DIM)
        self.window.refresh()

    def run(self):
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        self.window.timeout(200)
        next_refresh = 0
        last_second = None
        while True:
            now = time.time()
            changed = False
            if now >= next_refresh:
                self.monitor.refresh()
                next_refresh = now + self.interval
                changed = True
            key = self.window.getch()
            if key in (ord("q"), ord("Q")):
                return
            if key in (curses.KEY_UP, ord("k")):
                self.move(-1)
            elif key in (curses.KEY_DOWN, ord("j")):
                self.move(1)
            if key != -1 or changed or int(now) != last_second:
                last_second = int(now)
                self.draw()


